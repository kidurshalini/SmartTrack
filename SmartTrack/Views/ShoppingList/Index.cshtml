@model SmartTrack.ViewModels.ShoppingListViewModel

@{
    ViewData["Title"] = "Shopping List";
}

<style>

    /* =========================================================
           SMARTTRACK THEME
        ========================================================= */

    :root {
        --primary-green: #198754;
        --dark-green: #146c43;
        --primary-blue: #0d6efd;
        --dark-blue: #084298;
        --primary-yellow: #ffc107;
        --light-green: #eaf7ef;
        --light-blue: #eaf2ff;
        --light-yellow: #fff8df;
        --light-red: #fff0f0;
        --text-dark: #212529;
        --text-muted: #6c757d;
        --border-light: #e9ecef;
        --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.10);
        --shadow-md: 0 12px 40px rgba(0, 0, 0, 0.15);
        --shadow-lg: 0 25px 70px rgba(0, 0, 0, 0.20);
        --radius-sm: 12px;
        --radius-md: 20px;
        --radius-lg: 28px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }


    /* =========================================================
           GLOBAL
        ========================================================= */

    html,
    body {
        width: 100%;
        max-width: 100%;
        overflow-x: hidden !important;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    .smarttrack-shopping {
        width: 100%;
        max-width: 100%;
    }


    /* =========================================================
           PAGE BACKGROUND
        ========================================================= */

    .shopping-page-wrapper {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient( 180deg, #f7faf8 0%, #f8faff 100% );
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .shopping-header {
        width: 100%;
        margin-bottom: 25px;
    }

    .shopping-header-content {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .shopping-header-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        background: var(--light-green);
        color: var(--primary-green);
        font-size: 1.15rem;
    }

    .shopping-header h2 {
        color: var(--text-dark);
        font-size: 1.65rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .shopping-header p {
        color: var(--text-muted);
        font-size: 0.76rem;
        margin: 0;
    }

    .shopping-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 30px;
        background: var(--light-green);
        color: var(--dark-green);
        border: 1px solid rgba(25, 135, 84, 0.12);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: .4px;
    }

    .shopping-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--primary-green);
    }


    /* =========================================================
           SUMMARY CARDS
        ========================================================= */

    .shopping-summary-row {
        width: 100%;
        margin-bottom: 25px;
    }

    .shopping-summary-column {
        min-width: 0;
    }

    .shopping-summary-card {
        position: relative;
        width: 100%;
        min-height: 135px;
        border: 0 !important;
        border-radius: var(--radius-md) !important;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
    }

        .shopping-summary-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .shopping-summary-card .card-body {
            padding: 20px;
        }

    .shopping-summary-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        margin-bottom: 11px;
        font-size: .9rem;
    }

    .shopping-summary-label {
        display: block;
        color: var(--text-muted);
        font-size: .62rem;
        font-weight: 800;
        letter-spacing: .55px;
        margin-bottom: 3px;
    }

    .shopping-summary-number {
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 3px;
    }

    .shopping-summary-description {
        color: var(--text-muted);
        font-size: .67rem;
    }


    /* TOTAL */

    .summary-total .shopping-summary-icon {
        background: var(--light-blue);
        color: var(--primary-blue);
    }

    .summary-total .shopping-summary-number {
        color: var(--primary-blue);
    }


    /* PURCHASED */

    .summary-purchased .shopping-summary-icon {
        background: var(--light-green);
        color: var(--primary-green);
    }

    .summary-purchased .shopping-summary-number {
        color: var(--primary-green);
    }


    /* REMAINING */

    .summary-remaining .shopping-summary-icon {
        background: var(--light-red);
        color: #dc3545;
    }

    .summary-remaining .shopping-summary-number {
        color: #dc3545;
    }


    /* =========================================================
           MAIN CARD
        ========================================================= */

    .shopping-card {
        width: 100%;
        border: 0 !important;
        border-radius: var(--radius-md) !important;
        overflow: hidden;
        background: #fff;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
    }

        .shopping-card:hover {
            box-shadow: var(--shadow-md);
        }

    .shopping-card-header {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 18px 20px;
        background: #fff;
        border-bottom: 1px solid #f1f3f5 !important;
    }

    .shopping-card-header-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        background: var(--light-blue);
        color: var(--primary-blue);
        font-size: .85rem;
    }

    .shopping-card-title {
        min-width: 0;
    }

        .shopping-card-title h5 {
            font-size: .95rem;
            font-weight: 700;
            margin: 0 0 2px;
        }

        .shopping-card-title span {
            color: var(--text-muted);
            font-size: .62rem;
        }


    /* =========================================================
           DESKTOP TABLE
        ========================================================= */

    .shopping-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .shopping-table {
        width: 100%;
        margin: 0;
        font-size: .72rem;
    }

        .shopping-table thead th {
            padding: 14px 12px;
            background: #f8f9fa;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-light);
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .25px;
            white-space: nowrap;
        }

        .shopping-table tbody td {
            padding: 15px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f3f5;
            color: var(--text-dark);
        }

        .shopping-table tbody tr {
            transition: var(--transition);
        }

            .shopping-table tbody tr:hover {
                background: #fafdfb;
            }

            .shopping-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .shopping-product-name {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 700;
    }

    .shopping-product-icon {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--light-green);
        color: var(--primary-green);
        font-size: .68rem;
    }


    /* =========================================================
           STATUS BADGES
        ========================================================= */

    .shopping-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: .54rem;
        font-weight: 800;
        white-space: nowrap;
        letter-spacing: .2px;
    }

    .shopping-badge-purchased {
        background: var(--light-green);
        color: var(--dark-green);
    }

    .shopping-badge-danger {
        background: var(--light-red);
        color: #dc3545;
    }

    .shopping-badge-warning {
        background: var(--light-yellow);
        color: #9a7400;
    }

    .shopping-badge-info {
        background: var(--light-blue);
        color: var(--dark-blue);
    }

    .shopping-badge-normal {
        background: var(--light-green);
        color: var(--dark-green);
    }


    /* =========================================================
           PRIORITY
        ========================================================= */

    .priority-high {
        color: #dc3545;
        font-weight: 700;
    }

    .priority-medium {
        color: #b88600;
        font-weight: 700;
    }

    .priority-normal {
        color: var(--primary-green);
        font-weight: 700;
    }


    /* =========================================================
           ACTION BUTTONS
        ========================================================= */

    .shopping-action-btn {
        min-height: 34px;
        border-radius: 9px;
        font-size: .62rem;
        font-weight: 700;
        transition: var(--transition);
    }

        .shopping-action-btn:hover {
            transform: translateY(-1px);
        }

    .shopping-purchased-btn {
        background: linear-gradient( 135deg, var(--primary-green), var(--dark-green) );
        border: none;
        color: #fff;
        box-shadow: 0 5px 14px rgba(25, 135, 84, .18);
    }

        .shopping-purchased-btn:hover {
            color: #fff;
            box-shadow: 0 8px 20px rgba(25, 135, 84, .25);
        }

    .shopping-remove-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 9px;
    }


    /* =========================================================
           MOBILE LIST
        ========================================================= */

    .mobile-shopping-list {
        display: none;
    }

    .mobile-shopping-item {
        width: 100%;
        padding: 15px;
        border-bottom: 1px solid var(--border-light);
        background: #fff;
        transition: var(--transition);
    }

        .mobile-shopping-item:last-child {
            border-bottom: 0;
        }

        .mobile-shopping-item:hover {
            background: #fafdfb;
        }

    .mobile-product-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 13px;
    }

    .mobile-product-info {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .mobile-product-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--light-green);
        color: var(--primary-green);
        font-size: .72rem;
    }

    .mobile-product-name {
        min-width: 0;
        font-size: .78rem;
        font-weight: 800;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    .mobile-product-quantity {
        color: var(--text-muted);
        font-size: .59rem;
    }


    /* =========================================================
           MOBILE DETAILS
        ========================================================= */

    .mobile-shopping-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 13px;
    }

    .mobile-detail-box {
        padding: 9px;
        border-radius: 9px;
        background: #f8f9fa;
        border: 1px solid #f0f1f2;
    }

    .mobile-detail-label {
        display: block;
        color: var(--text-muted);
        font-size: .55rem;
        margin-bottom: 3px;
    }

    .mobile-detail-value {
        display: block;
        color: var(--text-dark);
        font-size: .65rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }


    /* =========================================================
           MOBILE ACTIONS
        ========================================================= */

    .mobile-shopping-actions {
        display: flex;
        gap: 8px;
        width: 100%;
    }

        .mobile-shopping-actions form:first-child {
            flex: 1;
        }

        .mobile-shopping-actions .shopping-purchased-btn {
            width: 100%;
            min-height: 40px;
        }

        .mobile-shopping-actions .shopping-remove-btn {
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
        }


    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .shopping-empty {
        text-align: center;
        padding: 55px 20px;
    }

    .shopping-empty-icon {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: var(--light-green);
        color: var(--primary-green);
        font-size: 1.4rem;
    }

    .shopping-empty h5 {
        color: var(--text-dark);
        font-size: .95rem;
        margin-bottom: 7px;
    }

    .shopping-empty p {
        max-width: 460px;
        margin: 0 auto 18px;
        color: var(--text-muted);
        font-size: .68rem;
        line-height: 1.5;
    }

    .shopping-recommendation-btn {
        min-height: 42px;
        padding: 9px 17px;
        border: 0;
        border-radius: var(--radius-sm);
        background: linear-gradient( 135deg, var(--primary-green), var(--dark-green) );
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        box-shadow: 0 6px 18px rgba(25, 135, 84, .20);
        transition: var(--transition);
    }

        .shopping-recommendation-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(25, 135, 84, .28);
        }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 767.98px) {

        .shopping-page-wrapper {
            min-height: 100vh;
        }

        .container-fluid.smarttrack-shopping {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 12px 10px 25px !important;
        }
        /* HEADER */

        .shopping-header {
            margin-bottom: 18px;
        }

        .shopping-header-content {
            align-items: flex-start;
            gap: 9px;
        }

        .shopping-header-icon {
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
            border-radius: 10px;
            font-size: .9rem;
        }

        .shopping-header h2 {
            font-size: 1.3rem;
            line-height: 1.2;
        }

        .shopping-header p {
            font-size: .63rem;
            line-height: 1.4;
        }

        .shopping-status {
            padding: 7px 11px;
            font-size: .56rem;
        }
        /* SUMMARY */

        .shopping-summary-row {
            display: flex !important;
            flex-direction: column !important;
            gap: 10px;
            margin-bottom: 17px;
        }

        .shopping-summary-column {
            width: 100% !important;
            max-width: 100% !important;
            flex: 0 0 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .shopping-summary-card {
            min-height: 0;
            border-radius: 14px !important;
        }

            .shopping-summary-card .card-body {
                padding: 14px;
            }

        .shopping-summary-icon {
            width: 34px;
            height: 34px;
            margin-bottom: 8px;
        }

        .shopping-summary-label {
            font-size: .57rem;
        }

        .shopping-summary-number {
            font-size: 1.4rem;
        }

        .shopping-summary-description {
            font-size: .61rem;
        }
        /* MAIN CARD */

        .shopping-card {
            border-radius: 14px !important;
            margin-bottom: 15px;
        }

        .shopping-card-header {
            padding: 13px;
        }

        .shopping-card-header-icon {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
        }

        .shopping-card-title h5 {
            font-size: .85rem;
        }

        .shopping-card-title span {
            font-size: .57rem;
        }
        /* DESKTOP TABLE HIDDEN */

        .shopping-table-wrapper {
            display: none !important;
        }
        /* MOBILE LIST */

        .mobile-shopping-list {
            display: block;
            width: 100%;
        }

        .mobile-shopping-item {
            padding: 13px;
        }

        .mobile-product-name {
            font-size: .74rem;
        }

        .mobile-product-quantity {
            font-size: .57rem;
        }

        .shopping-badge {
            font-size: .51rem;
            padding: 5px 7px;
        }

        .mobile-shopping-details {
            gap: 7px;
        }

        .mobile-detail-box {
            padding: 8px;
        }

        .mobile-detail-label {
            font-size: .52rem;
        }

        .mobile-detail-value {
            font-size: .61rem;
        }
        /* EMPTY */

        .shopping-empty {
            padding: 35px 15px;
        }

        .shopping-empty-icon {
            width: 55px;
            height: 55px;
            font-size: 1rem;
        }

        .shopping-empty h5 {
            font-size: .85rem;
        }

        .shopping-empty p {
            font-size: .61rem;
        }

        .shopping-recommendation-btn {
            width: 100%;
            min-height: 40px;
            font-size: .65rem;
        }
        /* REMOVE BOOTSTRAP GUTTERS */

        .smarttrack-shopping .row {
            --bs-gutter-x: 0;
            --bs-gutter-y: 0;
        }
    }


    /* =========================================================
           VERY SMALL PHONES
        ========================================================= */

    @@media (max-width: 400px) {

        .container-fluid.smarttrack-shopping {
            padding-left: 8px !important;
            padding-right: 8px !important;
        }

        .shopping-header h2 {
            font-size: 1.2rem;
        }

        .shopping-header p {
            font-size: .59rem;
        }

        .shopping-summary-card .card-body {
            padding: 12px;
        }

        .shopping-summary-number {
            font-size: 1.3rem;
        }

        .shopping-card-header {
            padding: 11px;
        }

        .mobile-shopping-item {
            padding: 11px;
        }

        .mobile-shopping-details {
            grid-template-columns: 1fr 1fr;
        }
    }

</style>


<div class="shopping-page-wrapper">

    <div class="container-fluid py-3 py-md-4 smarttrack-shopping">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="shopping-header">

            <div class="d-flex
                        flex-column
                        flex-sm-row
                        justify-content-between
                        align-items-start
                        align-items-sm-center
                        gap-3">

                <div class="shopping-header-content">

                    <div class="shopping-header-icon">

                        <i class="fas fa-cart-shopping"></i>

                    </div>

                    <div>

                        <h2>
                            Shopping List
                        </h2>

                        <p>
                            Automatically created from your
                            SmartTrack purchase recommendations.
                        </p>

                    </div>

                </div>


                @if (Model.Status == "ACTIVE")
                {

                    <span class="shopping-status">

                        <span class="shopping-status-dot"></span>

                        ACTIVE

                    </span>

                }

            </div>

        </div>


        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <div class="row g-3 shopping-summary-row">


            <!-- TOTAL -->

            <div class="col-12 col-sm-4 shopping-summary-column">

                <div class="card shopping-summary-card summary-total">

                    <div class="card-body">

                        <div class="shopping-summary-icon">

                            <i class="fas fa-list-check"></i>

                        </div>

                        <span class="shopping-summary-label">
                            TOTAL ITEMS
                        </span>

                        <div class="shopping-summary-number">
                            @Model.TotalItems
                        </div>

                        <span class="shopping-summary-description">
                            Items on your shopping list
                        </span>

                    </div>

                </div>

            </div>


            <!-- PURCHASED -->

            <div class="col-12 col-sm-4 shopping-summary-column">

                <div class="card shopping-summary-card summary-purchased">

                    <div class="card-body">

                        <div class="shopping-summary-icon">

                            <i class="fas fa-circle-check"></i>

                        </div>

                        <span class="shopping-summary-label">
                            PURCHASED
                        </span>

                        <div class="shopping-summary-number">
                            @Model.PurchasedItems
                        </div>

                        <span class="shopping-summary-description">
                            Items already purchased
                        </span>

                    </div>

                </div>

            </div>


            <!-- REMAINING -->

            <div class="col-12 col-sm-4 shopping-summary-column">

                <div class="card shopping-summary-card summary-remaining">

                    <div class="card-body">

                        <div class="shopping-summary-icon">

                            <i class="fas fa-cart-shopping"></i>

                        </div>

                        <span class="shopping-summary-label">
                            REMAINING
                        </span>

                        <div class="shopping-summary-number">
                            @Model.RemainingItems
                        </div>

                        <span class="shopping-summary-description">
                            Items still to purchase
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             EMPTY STATE
        ====================================================== -->
        @if (Model.Items == null ||
                Model.Items.Count == 0)
        {

            <div class="card shopping-card">

                <div class="shopping-empty">

                    <div class="shopping-empty-icon">

                        <i class="fas fa-cart-shopping"></i>

                    </div>

                    <h5>
                        Shopping List is Empty
                    </h5>

                    <p>
                        No purchase recommendations have been
                        added to your shopping list yet.
                    </p>

                    <a asp-controller="SmartTrackDashboard"
                       asp-action="Recommendations"
                       class="btn shopping-recommendation-btn">

                        <i class="fas fa-lightbulb me-2"></i>

                        View Recommendations

                    </a>

                </div>

            </div>

        }
        else
        {

            <!-- =================================================
                 ITEMS CARD
            ================================================== -->

            <div class="card shopping-card">


                <!-- HEADER -->

                <div class="shopping-card-header">

                    <div class="shopping-card-header-icon">

                        <i class="fas fa-basket-shopping"></i>

                    </div>

                    <div class="shopping-card-title">

                        <h5>
                            Items to Purchase
                        </h5>

                        <span>
                            Automatically generated from SmartTrack
                            recommendations
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     DESKTOP TABLE
                ================================================== -->

                <div class="shopping-table-wrapper">

                    <table class="table shopping-table">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    Product
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Expected Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.Items)
                            {

                                <tr>


                                    <!-- PRODUCT -->

                                    <td class="ps-4">

                                        <div class="shopping-product-name">

                                            <div class="shopping-product-icon">

                                                <i class="fas fa-box"></i>

                                            </div>

                                            <span>
                                                @item.Product
                                            </span>

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.IsPurchased)
                                        {

                                            <span class="shopping-badge shopping-badge-purchased">
                                                PURCHASED
                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 0)
                                        {

                                            <span class="shopping-badge shopping-badge-danger">
                                                PURCHASE NOW
                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 3)
                                        {

                                            <span class="shopping-badge shopping-badge-warning">
                                                DUE SOON
                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 7)
                                        {

                                            <span class="shopping-badge shopping-badge-info">
                                                UPCOMING
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="shopping-badge shopping-badge-normal">
                                                OK
                                            </span>

                                        }

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        @if (item.ExpectedPurchaseDate.HasValue)
                                        {

                                            @item.ExpectedPurchaseDate.Value.ToString("dd/MM/yyyy")

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                —
                                            </span>

                                        }

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        @if (item.IsPurchased)
                                        {

                                            <strong class="text-success">
                                                Purchased
                                            </strong>

                                        }
                                        else if (item.DaysUntilPurchase <= 0)
                                        {

                                            <strong class="text-danger">
                                                Overdue
                                            </strong>

                                        }
                                        else
                                        {

                                            <strong>
                                                @item.DaysUntilPurchase days left
                                            </strong>

                                        }

                                    </td>


                                    <!-- PRIORITY -->

                                    <td>

                                        @if (item.Priority == "HIGH")
                                        {

                                            <span class="priority-high">
                                                ● High
                                            </span>

                                        }
                                        else if (item.Priority == "MEDIUM")
                                        {

                                            <span class="priority-medium">
                                                ● Medium
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="priority-normal">
                                                ● Normal
                                            </span>

                                        }

                                    </td>


                                    <!-- QUANTITY -->

                                    <td>

                                        <strong>
                                            @item.Quantity
                                        </strong>

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end pe-4">

                                        @if (!item.IsPurchased)
                                        {

                                            <form asp-controller="ShoppingList"
                                                  asp-action="MarkPurchased"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn shopping-action-btn shopping-purchased-btn">

                                                    <i class="fas fa-check me-1"></i>

                                                    Purchased

                                                </button>

                                            </form>

                                        }
                                        else
                                        {

                                            <span class="text-success me-2">

                                                <i class="fas fa-circle-check"></i>

                                            </span>

                                        }


                                        <form asp-controller="ShoppingList"
                                              asp-action="RemoveItem"
                                              method="post"
                                              class="d-inline ms-1">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger shopping-action-btn shopping-remove-btn"
                                                    title="Remove item">

                                                <i class="fas fa-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                ================================================== -->

                <div class="mobile-shopping-list">

                    @foreach (var item in Model.Items)
                    {

                        <div class="mobile-shopping-item">


                            <!-- PRODUCT HEADER -->

                            <div class="mobile-product-header">

                                <div class="mobile-product-info">

                                    <div class="mobile-product-icon">

                                        <i class="fas fa-box"></i>

                                    </div>

                                    <div>

                                        <div class="mobile-product-name">
                                            @item.Product
                                        </div>

                                        <div class="mobile-product-quantity">

                                            Quantity:
                                            <strong>
                                                @item.Quantity
                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div>

                                    @if (item.IsPurchased)
                                    {

                                        <span class="shopping-badge shopping-badge-purchased">
                                            PURCHASED
                                        </span>

                                    }
                                    else if (item.DaysUntilPurchase <= 0)
                                    {

                                        <span class="shopping-badge shopping-badge-danger">
                                            PURCHASE NOW
                                        </span>

                                    }
                                    else if (item.DaysUntilPurchase <= 3)
                                    {

                                        <span class="shopping-badge shopping-badge-warning">
                                            DUE SOON
                                        </span>

                                    }
                                    else if (item.DaysUntilPurchase <= 7)
                                    {

                                        <span class="shopping-badge shopping-badge-info">
                                            UPCOMING
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="shopping-badge shopping-badge-normal">
                                            OK
                                        </span>

                                    }

                                </div>

                            </div>


                            <!-- DETAILS -->

                            <div class="mobile-shopping-details">


                                <!-- DATE -->

                                <div class="mobile-detail-box">

                                    <span class="mobile-detail-label">
                                        EXPECTED DATE
                                    </span>

                                    <span class="mobile-detail-value">

                                        @if (item.ExpectedPurchaseDate.HasValue)
                                        {

                                            @item.ExpectedPurchaseDate.Value.ToString("dd/MM/yyyy")

                                        }
                                        else
                                        {

                                            <span>—</span>

                                        }

                                    </span>

                                </div>


                                <!-- TIME -->

                                <div class="mobile-detail-box">

                                    <span class="mobile-detail-label">
                                        TIME
                                    </span>

                                    <span class="mobile-detail-value">

                                        @if (item.IsPurchased)
                                        {

                                            <span class="text-success">
                                                Purchased
                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 0)
                                        {

                                            <span class="text-danger">
                                                Overdue
                                            </span>

                                        }
                                        else
                                        {

                                            @item.DaysUntilPurchase
                                            <span> days left</span>

                                        }

                                    </span>

                                </div>


                                <!-- PRIORITY -->

                                <div class="mobile-detail-box">

                                    <span class="mobile-detail-label">
                                        PRIORITY
                                    </span>

                                    <span class="mobile-detail-value">

                                        @if (item.Priority == "HIGH")
                                        {

                                            <span class="priority-high">
                                                ● High
                                            </span>

                                        }
                                        else if (item.Priority == "MEDIUM")
                                        {

                                            <span class="priority-medium">
                                                ● Medium
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="priority-normal">
                                                ● Normal
                                            </span>

                                        }

                                    </span>

                                </div>


                                <!-- STATUS -->

                                <div class="mobile-detail-box">

                                    <span class="mobile-detail-label">
                                        STATUS
                                    </span>

                                    <span class="mobile-detail-value">
                                        @item.RecommendationStatus
                                    </span>

                                </div>

                            </div>


                            <!-- ACTIONS -->

                            <div class="mobile-shopping-actions">

                                @if (!item.IsPurchased)
                                {

                                    <form asp-controller="ShoppingList"
                                          asp-action="MarkPurchased"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn shopping-purchased-btn">

                                            <i class="fas fa-check me-1"></i>

                                            Mark Purchased

                                        </button>

                                    </form>

                                }


                                <form asp-controller="ShoppingList"
                                      asp-action="RemoveItem"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger shopping-remove-btn"
                                            title="Remove item">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </div>

                    }

                </div>

            </div>

        }

    </div>

</div>