@model SmartTrack.ViewModels.SavedReceiptsViewModel

@{
    ViewData["Title"] = "Saved Receipts";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-4">

        <h2 class="fw-bold text-success">

            <i class="bi bi-receipt-cutoff me-2"></i>

            Saved Receipts

        </h2>

        <p class="text-muted">
            View receipts saved by your household members.
        </p>

    </div>


    <!-- Household Information -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold text-success mb-1">

                        <i class="bi bi-house-door me-2"></i>

                        Household Information

                    </h5>

                    <p class="text-muted mb-0">
                        Receipts belonging to this household
                    </p>

                </div>

                <span class="badge bg-success fs-6 px-3 py-2">

                     Household Name:
                    @Model.HouseholdName
                    <br />
                    Household ID:
                    @Model.HouseholdId

                   
                </span>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- RECEIPTS TABLE -->
    <!-- ================================================= -->

    <div class="card shadow-sm border-0 rounded-4 mb-5">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h4 class="fw-bold text-success">

                        <i class="bi bi-receipt me-2"></i>

                        Saved Receipts

                    </h4>

                    <p class="text-muted mb-0">
                        All receipts saved by household users.
                    </p>

                </div>

                <span class="badge bg-success">

                    @Model.Receipts.Count Receipts

                </span>

            </div>


            @if (Model.Receipts.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-success">

                            <tr>

                                <th>#</th>

                                <th>Receipt ID</th>

                                <th>Purchase Date</th>

                                <th>Total Amount</th>

                                <th>Items</th>

                                <th>Created By</th>

                                <th>Created On</th>

                                <th>Modified On</th>

                                <th>Modified By</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int number = 1;
                            }

                            @foreach (var receipt in Model.Receipts)
                            {
                                <tr>

                                    <td>
                                        @number
                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">
                                            #@receipt.Id
                                        </span>

                                    </td>

                                    <td>
                                        @receipt.PurchaseDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="fw-bold text-success">
                                        Rs @receipt.TotalAmount.ToString("0.00")
                                    </td>

                                    <td>
                                        @receipt.ItemCount
                                    </td>

                                    <td>
                                        @receipt.CreatedByName
                                    </td>

                                    <td>
                                        @receipt.CreatedOn.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @(receipt.ModifiedOn.HasValue
                                                                        ? receipt.ModifiedOn.Value.ToString("yyyy-MM-dd HH:mm")
                                                                        : "-")
                                                                          </td>

                                    <td>
                                        @(string.IsNullOrEmpty(receipt.ModifiedByName)
                                                                        ? "-"
                                                                        : receipt.ModifiedByName)
                            </td>

                                                            <td>

                                                                <a asp-action="EditReceipt"
                                                                   asp-route-id="@receipt.Id"
                                                                   class="btn btn-sm btn-primary rounded-pill">

                                                                    <i class="bi bi-pencil me-1"></i>

                                                                    Edit

                                                                </a>

                                                            </td>

                                                        </tr>

                                                        number++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-receipt text-muted"
                       style="font-size:60px;">
                    </i>

                    <h5 class="mt-3 text-muted">
                        No saved receipts found.
                    </h5>

                    <p class="text-muted">
                        Scan and save a receipt to see it here.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ================================================= -->
    <!-- RECEIPT ITEMS TABLE -->
    <!-- ================================================= -->

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <h4 class="fw-bold text-success">

                <i class="bi bi-cart-check me-2"></i>

                Receipt Items

            </h4>

            <p class="text-muted">
                All items extracted from household receipts.
            </p>


            @if (Model.ReceiptItems.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-success">

                            <tr>

                                <th>#</th>

                                <th>Receipt ID</th>

                                <th>Purchase Date</th>

                                <th>Item Name</th>

                                <th>Quantity</th>

                                <th>Unit</th>

                                <th>Unit Price</th>

                                <th>Total Price</th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int itemNumber = 1;
                            }

                            @foreach (var item in Model.ReceiptItems)
                            {
                                <tr>

                                    <td>
                                        @itemNumber
                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">
                                            #@item.ReceiptId
                                        </span>

                                    </td>

                                    <td>
                                        @item.PurchaseDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="fw-semibold">
                                        @item.ItemName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.Unit
                                    </td>

                                    <td>
                                        Rs @item.UnitPrice.ToString("0.00")
                                    </td>

                                    <td class="fw-semibold text-success">
                                        Rs @item.TotalPrice.ToString("0.00")
                                    </td>

                                </tr>

                                itemNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-cart-x text-muted"
                       style="font-size:60px;">
                    </i>

                    <h5 class="mt-3 text-muted">
                        No receipt items found.
                    </h5>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .card {
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .table {
        border-radius: 10px;
        overflow: hidden;
    }

        .table th {
            white-space: nowrap;
        }

</style>