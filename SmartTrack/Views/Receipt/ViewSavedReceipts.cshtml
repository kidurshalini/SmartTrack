@model SmartTrack.ViewModels.SavedReceiptsViewModel

@{
    ViewData["Title"] = "Saved Receipts";
}

<style>

    /* =========================================================
           SMARTTRACK SAVED RECEIPTS
           ========================================================= */

    .saved-receipts-page {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .receipts-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .receipts-title-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .receipts-title-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg, #198754, #157347);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.22);
        flex-shrink: 0;
    }

    .receipts-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.4px;
    }

    .receipts-subtitle {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .receipt-count-badge {
        background: #e8f7ef;
        color: #198754;
        border: 1px solid #c8ead7;
        border-radius: 50px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           SEARCH BAR
           ========================================================= */

    .receipts-search-wrapper {
        margin-bottom: 24px;
    }

    .receipts-search-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 18px;
        padding: 16px 18px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .receipts-search-box {
        position: relative;
        width: 100%;
    }

    .receipts-search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 15px;
        pointer-events: none;
    }

    .receipts-search-input {
        width: 100%;
        height: 46px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        color: #334155;
        font-size: 13px;
        padding: 0 45px 0 42px;
        outline: none;
        transition: all 0.2s ease;
    }

        .receipts-search-input::placeholder {
            color: #94a3b8;
        }

        .receipts-search-input:focus {
            background: #ffffff;
            border-color: #198754;
            box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.10);
        }

    .clear-search-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 8px;
        background: #e2e8f0;
        color: #64748b;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .clear-search-btn:hover {
            background: #198754;
            color: #ffffff;
        }

    .search-result-info {
        margin-top: 9px;
        color: #94a3b8;
        font-size: 11px;
    }


    /* =========================================================
           NO SEARCH RESULTS
           ========================================================= */

    .search-no-results {
        display: none;
        padding: 35px 20px;
        text-align: center;
        color: #94a3b8;
    }

        .search-no-results i {
            font-size: 28px;
            margin-bottom: 10px;
        }

        .search-no-results h6 {
            margin: 0 0 5px;
            color: #64748b;
            font-weight: 700;
        }

        .search-no-results p {
            margin: 0;
            font-size: 12px;
        }


    /* =========================================================
           COMMON CARD
           ========================================================= */

    .smart-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 20px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .smart-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08), 0 2px 5px rgba(15, 23, 42, 0.04);
        }


    /* =========================================================
           HOUSEHOLD CARD
           ========================================================= */

    .household-card {
        position: relative;
        margin-bottom: 24px;
        overflow: hidden;
    }

        .household-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: linear-gradient(180deg, #198754, #20c997);
        }

    .household-body {
        padding: 22px 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .household-left {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    .household-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #e9f7ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .household-title {
        margin: 0;
        color: #0f172a;
        font-size: 17px;
        font-weight: 700;
    }

    .household-description {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .household-details {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .household-detail {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 9px 13px;
        min-width: 145px;
    }

    .household-detail-label {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .household-detail-value {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        word-break: break-word;
    }


    /* =========================================================
           SECTION CARD
           ========================================================= */

    .section-card {
        margin-bottom: 24px;
    }

        .section-card:last-child {
            margin-bottom: 0;
        }

    .section-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #eef1f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .section-heading-area {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eaf7f0;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .section-heading {
        margin: 0;
        color: #0f172a;
        font-size: 18px;
        font-weight: 700;
    }

    .section-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: 12px;
    }

    .section-count {
        background: #198754;
        color: #fff;
        padding: 8px 13px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .section-card-body {
        padding: 0;
    }


    /* =========================================================
           DESKTOP TABLE
           ========================================================= */

    .desktop-table {
        display: block;
        overflow-x: auto;
        width: 100%;
    }

    .smart-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 950px;
    }

        .smart-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e5e7eb;
            border-top: none;
            padding: 13px 15px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            white-space: nowrap;
            vertical-align: middle;
        }

        .smart-table tbody td {
            padding: 14px 15px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .smart-table tbody tr {
            transition: background 0.2s ease;
        }

            .smart-table tbody tr:hover {
                background: #f8fcfa;
            }

            .smart-table tbody tr:last-child td {
                border-bottom: none;
            }

    .row-number {
        color: #94a3b8;
        font-weight: 600;
    }

    .receipt-id {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
    }

    .amount {
        color: #198754 !important;
        font-weight: 700;
    }

    .item-name {
        color: #1e293b !important;
        font-weight: 600;
    }

    .muted-value {
        color: #94a3b8;
    }


    /* =========================================================
           EDIT BUTTON
           ========================================================= */

    .edit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 9px;
        border: none;
        background: #eaf3ff;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 700;
        transition: all 0.2s ease;
        white-space: nowrap;
        text-decoration: none;
    }

        .edit-btn:hover {
            background: #0d6efd;
            color: #fff;
            transform: translateY(-1px);
        }


    /* =========================================================
           MOBILE CONTENT
           ========================================================= */

    .mobile-content {
        display: none;
    }


    /* =========================================================
           MOBILE RECEIPT CARD
           ========================================================= */

    .receipt-mobile-card,
    .item-mobile-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 17px;
        margin-bottom: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .receipt-mobile-card:hover,
        .item-mobile-card:hover {
            border-color: #cce9d8;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.07);
        }

        .receipt-mobile-card:last-child,
        .item-mobile-card:last-child {
            margin-bottom: 0;
        }

    .receipt-mobile-header,
    .item-mobile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-bottom: 13px;
        margin-bottom: 5px;
        border-bottom: 1px solid #eef1f4;
    }

    .receipt-mobile-title,
    .item-mobile-name {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #198754;
        font-size: 15px;
        font-weight: 700;
        min-width: 0;
        word-break: break-word;
    }

    .mobile-badge {
        flex-shrink: 0;
        padding: 5px 9px;
        background: #eaf7f0;
        color: #198754;
        border-radius: 50px;
        font-size: 10px;
        font-weight: 700;
    }

    .mobile-info-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .mobile-info-row:last-of-type {
            border-bottom: none;
        }

    .mobile-info-label {
        color: #94a3b8;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.25px;
        flex: 0 0 42%;
    }

    .mobile-info-value {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .mobile-edit-btn {
        width: 100%;
        margin-top: 14px;
        padding: 10px;
        border-radius: 10px;
        background: #0d6efd;
        color: #fff;
        border: none;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
    }

        .mobile-edit-btn:hover {
            background: #084298;
            color: #fff;
        }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon-wrapper {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        border-radius: 22px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .empty-title {
        margin: 0 0 6px;
        color: #475569;
        font-size: 16px;
        font-weight: 700;
    }

    .empty-description {
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
    }


    /* =========================================================
           SEARCH NO RESULTS
           ========================================================= */

    .search-empty-state {
        display: none;
        padding: 45px 20px;
        text-align: center;
    }

    .search-empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 14px;
        border-radius: 18px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .search-empty-title {
        margin: 0 0 5px;
        color: #475569;
        font-size: 15px;
        font-weight: 700;
    }

    .search-empty-description {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 992px) {

        .receipts-page-header {
            margin-bottom: 22px;
        }

        .household-body {
            align-items: flex-start;
            flex-direction: column;
        }

        .household-details {
            width: 100%;
            justify-content: flex-start;
        }

        .household-detail {
            flex: 1;
        }
    }


    @@media (max-width: 767px) {

        .saved-receipts-page {
            width: 100%;
        }

        .receipts-page-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .receipts-title-area {
            width: 100%;
        }

        .receipts-title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            font-size: 19px;
        }

        .receipts-title {
            font-size: 23px;
        }

        .receipts-subtitle {
            font-size: 12px;
        }

        .receipt-count-badge {
            align-self: flex-start;
        }

        .receipts-search-wrapper {
            margin-bottom: 18px;
        }

        .receipts-search-card {
            padding: 13px;
            border-radius: 15px;
        }

        .receipts-search-input {
            height: 44px;
            font-size: 12px;
            padding-left: 39px;
        }

        .receipts-search-icon {
            left: 13px;
            font-size: 14px;
        }

        .clear-search-btn {
            right: 9px;
        }

        .household-body {
            padding: 18px;
        }

        .household-left {
            align-items: flex-start;
        }

        .household-icon {
            width: 42px;
            height: 42px;
            font-size: 18px;
        }

        .household-title {
            font-size: 15px;
        }

        .household-description {
            font-size: 12px;
        }

        .household-details {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .household-detail {
            width: 100%;
        }

        .section-card-header {
            padding: 17px;
            align-items: flex-start;
        }

        .section-heading-area {
            align-items: flex-start;
        }

        .section-icon {
            width: 38px;
            height: 38px;
            font-size: 16px;
        }

        .section-heading {
            font-size: 16px;
        }

        .section-description {
            font-size: 11px;
        }

        .section-count {
            font-size: 10px;
            padding: 7px 10px;
        }

        .desktop-table {
            display: none;
        }

        .mobile-content {
            display: block;
            padding: 15px;
        }

        .section-card-body {
            padding: 0;
        }

        .empty-state {
            padding: 45px 18px;
        }

        .empty-icon-wrapper {
            width: 65px;
            height: 65px;
            border-radius: 18px;
            font-size: 27px;
        }
    }


    @@media (max-width: 480px) {

        .receipts-title {
            font-size: 21px;
        }

        .receipts-title-icon {
            width: 42px;
            height: 42px;
            font-size: 17px;
        }

        .household-body {
            padding: 16px;
        }

        .section-card-header {
            padding: 15px;
        }

        .section-heading-area {
            gap: 9px;
        }

        .section-icon {
            width: 34px;
            height: 34px;
            font-size: 14px;
        }

        .section-heading {
            font-size: 15px;
        }

        .section-count {
            display: none;
        }

        .mobile-content {
            padding: 12px;
        }

        .receipt-mobile-card,
        .item-mobile-card {
            padding: 14px;
        }

        .receipt-mobile-header,
        .item-mobile-header {
            align-items: flex-start;
        }

        .mobile-info-row {
            flex-direction: column;
            gap: 3px;
        }

        .mobile-info-label {
            flex: auto;
        }

        .mobile-info-value {
            width: 100%;
            text-align: left;
        }
    }

</style>


<div class="container-fluid py-4">

    <div class="saved-receipts-page">


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="receipts-page-header">

            <div class="receipts-title-area">

                <div class="receipts-title-icon">
                    <i class="fas fa-receipt"></i>
                </div>

                <div>

                    <h1 class="receipts-title">
                        Saved Receipts
                    </h1>

                    <p class="receipts-subtitle">
                        View and manage receipts saved by your household.
                    </p>

                </div>

            </div>

            <div class="receipt-count-badge">

                <i class="fas fa-file-invoice me-1"></i>

                @Model.Receipts.Count Receipts

            </div>

        </div>


        <!-- =====================================================
             SEARCH BAR
             ===================================================== -->

        <div class="receipts-search-wrapper">

            <div class="receipts-search-card">

                <div class="receipts-search-box">

                    <i class="fas fa-search receipts-search-icon"></i>

                    <input type="text"
                           id="receiptSearch"
                           class="receipts-search-input"
                           placeholder="Search receipts, items, dates, users, amounts..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearReceiptSearch"
                            class="clear-search-btn"
                            aria-label="Clear search">

                        <i class="fas fa-times"></i>

                    </button>

                </div>

                <div id="searchResultInfo"
                     class="search-result-info">

                    Showing all receipts and items

                </div>

            </div>

        </div>


        <!-- =====================================================
             HOUSEHOLD INFORMATION
             ===================================================== -->

        <div class="smart-card household-card">

            <div class="household-body">

                <div class="household-left">

                    <div class="household-icon">
                        <i class="fas fa-house"></i>
                    </div>

                    <div>

                        <h5 class="household-title">
                            Household Information
                        </h5>

                        <p class="household-description">
                            Receipts belonging to this household
                        </p>

                    </div>

                </div>


                <div class="household-details">

                    <div class="household-detail">

                        <span class="household-detail-label">
                            Household Name
                        </span>

                        <span class="household-detail-value">
                            @Model.HouseholdName
                        </span>

                    </div>

                    <div class="household-detail">

                        <span class="household-detail-label">
                            Household ID
                        </span>

                        <span class="household-detail-value">
                            @Model.HouseholdId
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SAVED RECEIPTS
             ===================================================== -->

        <div class="smart-card section-card">

            <div class="section-card-header">

                <div class="section-heading-area">

                    <div class="section-icon">
                        <i class="fas fa-receipt"></i>
                    </div>

                    <div>

                        <h4 class="section-heading">
                            Saved Receipts
                        </h4>

                        <p class="section-description">
                            All receipts saved by household users.
                        </p>

                    </div>

                </div>

                <span class="section-count"
                      id="receiptSectionCount">

                    @Model.Receipts.Count Receipts

                </span>

            </div>


            <div class="section-card-body">

                @if (Model.Receipts.Any())
                {

                    <!-- =================================================
                         DESKTOP TABLE
                         ================================================= -->

                    <div class="desktop-table">

                        <table class="smart-table">

                            <thead>

                                <tr>

                                    <th>#</th>
                                    <th>Receipt ID</th>
                                    <th>Purchase Date</th>
                                    <th>Total Amount</th>
                                    <th>Items</th>
                                    <th>Created By</th>
                                    <th>Created On</th>
                                    <th>Modified On</th>
                                    <th>Modified By</th>
                                    <th>Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    int number = 1;
                                }

                                @foreach (var receipt in Model.Receipts)
                                {

                                    <tr class="receipt-search-item"
                                        data-search="@receipt.Id @receipt.PurchaseDate @receipt.TotalAmount @receipt.ItemCount @receipt.CreatedByName @receipt.CreatedOn @receipt.ModifiedOn @receipt.ModifiedByName">

                                        <td class="row-number">
                                            @number
                                        </td>

                                        <td>

                                            <span class="receipt-id">
                                                #@receipt.Id
                                            </span>

                                        </td>

                                        <td>
                                            @receipt.PurchaseDate
                                        </td>

                                        <td class="amount">
                                            Rs @receipt.TotalAmount
                                        </td>

                                        <td>

                                            <span class="mobile-badge">
                                                @receipt.ItemCount
                                            </span>

                                        </td>

                                        <td>
                                            @receipt.CreatedByName
                                        </td>

                                        <td>
                                            @receipt.CreatedOn
                                        </td>

                                        <td>

                                            @(receipt.ModifiedOn.HasValue
                                                                                ? receipt.ModifiedOn.Value
                                                                                : "-")

                                        </td>

                                        <td>

                                            @(string.IsNullOrEmpty(receipt.ModifiedByName)
                                                                                ? "-"
                                                                                : receipt.ModifiedByName)

                                </td>

                                                                    <td>

                                                                        <a asp-action="EditReceipt"
                                                                           asp-route-id="@receipt.Id"
                                                                           class="edit-btn">

                                                                            <i class="fas fa-pen"></i>

                                                                            Edit

                                                                        </a>

                                                                    </td>

                                                                </tr>

                                                                number++;

                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- =================================================
                         MOBILE CARDS
                         ================================================= -->

                    <div class="mobile-content">

                        @foreach (var receipt in Model.Receipts)
                        {

                            <div class="receipt-mobile-card receipt-search-item"
                                 data-search="@receipt.Id @receipt.PurchaseDate @receipt.TotalAmount @receipt.ItemCount @receipt.CreatedByName @receipt.CreatedOn @receipt.ModifiedOn @receipt.ModifiedByName">

                                <div class="receipt-mobile-header">

                                    <span class="receipt-mobile-title">

                                        <i class="fas fa-receipt"></i>

                                        Receipt #@receipt.Id

                                    </span>

                                    <span class="mobile-badge">

                                        @receipt.ItemCount Items

                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Receipt ID
                                    </span>

                                    <span class="mobile-info-value">
                                        #@receipt.Id
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Purchase Date
                                    </span>

                                    <span class="mobile-info-value">
                                        @receipt.PurchaseDate
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Total Amount
                                    </span>

                                    <span class="mobile-info-value amount">
                                        Rs @receipt.TotalAmount
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Number of Items
                                    </span>

                                    <span class="mobile-info-value">
                                        @receipt.ItemCount
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Created By
                                    </span>

                                    <span class="mobile-info-value">
                                        @receipt.CreatedByName
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Created On
                                    </span>

                                    <span class="mobile-info-value">
                                        @receipt.CreatedOn
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Modified On
                                    </span>

                                    <span class="mobile-info-value">

                                        @(receipt.ModifiedOn.HasValue
                                                                        ? receipt.ModifiedOn.Value
                                                                        : "-")

                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Modified By
                                    </span>

                                    <span class="mobile-info-value">

                                        @(string.IsNullOrEmpty(receipt.ModifiedByName)
                                                                        ? "-"
                                                                        : receipt.ModifiedByName)

                            </span>

                                </div>


                                <a asp-action="EditReceipt"
                                   asp-route-id="@receipt.Id"
                                   class="mobile-edit-btn">

                                    <i class="fas fa-pen"></i>

                                    Edit Receipt

                                </a>

                            </div>

                                        }

                    </div>


                    <!-- =================================================
                         NO RECEIPT SEARCH RESULTS
                         ================================================= -->

                    <div id="receiptSearchEmpty"
                         class="search-empty-state">

                        <div class="search-empty-icon">

                            <i class="fas fa-search"></i>

                        </div>

                        <h6 class="search-empty-title">
                            No receipts found
                        </h6>

                        <p class="search-empty-description">
                            Try searching with another receipt ID, date,
                            amount, or user name.
                        </p>

                    </div>

                }
                else
                {

                    <div class="empty-state">

                        <div class="empty-icon-wrapper">

                            <i class="fas fa-receipt"></i>

                        </div>

                        <h5 class="empty-title">
                            No saved receipts found
                        </h5>

                        <p class="empty-description">
                            Scan and save a receipt to see it here.
                        </p>

                    </div>

                }

            </div>

        </div>


        <!-- =====================================================
             RECEIPT ITEMS
             ===================================================== -->

        <div class="smart-card section-card">

            <div class="section-card-header">

                <div class="section-heading-area">

                    <div class="section-icon">

                        <i class="fas fa-cart-shopping"></i>

                    </div>

                    <div>

                        <h4 class="section-heading">
                            Receipt Items
                        </h4>

                        <p class="section-description">
                            All items extracted from household receipts.
                        </p>

                    </div>

                </div>

                <span class="section-count"
                      id="itemSectionCount">

                    @Model.ReceiptItems.Count Items

                </span>

            </div>


            <div class="section-card-body">

                @if (Model.ReceiptItems.Any())
                {

                    <!-- =================================================
                         DESKTOP ITEMS TABLE
                         ================================================= -->

                    <div class="desktop-table">

                        <table class="smart-table">

                            <thead>

                                <tr>

                                    <th>#</th>
                                    <th>Receipt ID</th>
                                    <th>Purchase Date</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Price</th>
                                    <th>Total Price</th>

                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    int itemNumber = 1;
                                }

                                @foreach (var item in Model.ReceiptItems)
                                {

                                    <tr class="receipt-item-search-item"
                                        data-search="@item.ReceiptId @item.PurchaseDate @item.ItemName @item.Quantity @item.Unit @item.UnitPrice @item.TotalPrice">

                                        <td class="row-number">
                                            @itemNumber
                                        </td>

                                        <td>

                                            <span class="receipt-id">
                                                #@item.ReceiptId
                                            </span>

                                        </td>

                                        <td>
                                            @item.PurchaseDate
                                        </td>

                                        <td class="item-name">
                                            @item.ItemName
                                        </td>

                                        <td>
                                            @item.Quantity
                                        </td>

                                        <td>
                                            @item.Unit
                                        </td>

                                        <td>
                                            Rs @item.UnitPrice
                                        </td>

                                        <td class="amount">
                                            Rs @item.TotalPrice
                                        </td>

                                    </tr>

                                    itemNumber++;

                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- =================================================
                         MOBILE ITEMS
                         ================================================= -->

                    <div class="mobile-content">

                        @foreach (var item in Model.ReceiptItems)
                        {

                            <div class="item-mobile-card receipt-item-search-item"
                                 data-search="@item.ReceiptId @item.PurchaseDate @item.ItemName @item.Quantity @item.Unit @item.UnitPrice @item.TotalPrice">

                                <div class="item-mobile-header">

                                    <span class="item-mobile-name">

                                        <i class="fas fa-cart-shopping"></i>

                                        @item.ItemName

                                    </span>

                                    <span class="mobile-badge">

                                        #@item.ReceiptId

                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Receipt ID
                                    </span>

                                    <span class="mobile-info-value">
                                        #@item.ReceiptId
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Purchase Date
                                    </span>

                                    <span class="mobile-info-value">
                                        @item.PurchaseDate
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Item Name
                                    </span>

                                    <span class="mobile-info-value">
                                        @item.ItemName
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Quantity
                                    </span>

                                    <span class="mobile-info-value">
                                        @item.Quantity
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Unit
                                    </span>

                                    <span class="mobile-info-value">
                                        @item.Unit
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Unit Price
                                    </span>

                                    <span class="mobile-info-value">
                                        Rs @item.UnitPrice
                                    </span>

                                </div>


                                <div class="mobile-info-row">

                                    <span class="mobile-info-label">
                                        Total Price
                                    </span>

                                    <span class="mobile-info-value amount">
                                        Rs @item.TotalPrice
                                    </span>

                                </div>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         NO ITEM SEARCH RESULTS
                         ================================================= -->

                    <div id="itemSearchEmpty"
                         class="search-empty-state">

                        <div class="search-empty-icon">

                            <i class="fas fa-search"></i>

                        </div>

                        <h6 class="search-empty-title">
                            No receipt items found
                        </h6>

                        <p class="search-empty-description">
                            Try searching with another item name,
                            receipt ID, quantity, or price.
                        </p>

                    </div>

                }
                else
                {

                    <div class="empty-state">

                        <div class="empty-icon-wrapper">

                            <i class="fas fa-cart-shopping"></i>

                        </div>

                        <h5 class="empty-title">
                            No receipt items found
                        </h5>

                        <p class="empty-description">
                            Items extracted from receipts will appear here.
                        </p>

                    </div>

                }

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     SEARCH JAVASCRIPT
     ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("receiptSearch");

        const clearButton =
            document.getElementById("clearReceiptSearch");

        const resultInfo =
            document.getElementById("searchResultInfo");

        const receiptSectionCount =
            document.getElementById("receiptSectionCount");

        const itemSectionCount =
            document.getElementById("itemSectionCount");

        const receiptSearchEmpty =
            document.getElementById("receiptSearchEmpty");

        const itemSearchEmpty =
            document.getElementById("itemSearchEmpty");


        /*
         * IMPORTANT:
         *
         * Desktop and mobile contain the same data.
         * Therefore, each visible representation is searched
         * independently.
         */

        const receiptItems =
            document.querySelectorAll(".receipt-search-item");

        const itemItems =
            document.querySelectorAll(".receipt-item-search-item");


        function performSearch() {

            const searchValue =
                searchInput.value
                    .trim()
                    .toLowerCase();


            let visibleReceipts = 0;
            let visibleItems = 0;


            /* =====================================================
               SEARCH RECEIPTS
               ===================================================== */

            receiptItems.forEach(function (element) {

                const searchableText =
                    (element.getAttribute("data-search") || "")
                        .toLowerCase();

                const matches =
                    searchValue === "" ||
                    searchableText.includes(searchValue);


                element.style.display =
                    matches ? "" : "none";


                if (matches) {

                    visibleReceipts++;

                }

            });


            /* =====================================================
               SEARCH ITEMS
               ===================================================== */

            itemItems.forEach(function (element) {

                const searchableText =
                    (element.getAttribute("data-search") || "")
                        .toLowerCase();

                const matches =
                    searchValue === "" ||
                    searchableText.includes(searchValue);


                element.style.display =
                    matches ? "" : "none";


                if (matches) {

                    visibleItems++;

                }

            });


            /* =====================================================
               UPDATE COUNTS
               ===================================================== */

            if (searchValue === "") {

                receiptSectionCount.textContent =
                    "@Model.Receipts.Count Receipts";

                itemSectionCount.textContent =
                    "@Model.ReceiptItems.Count Items";

            }
            else {

                receiptSectionCount.textContent =
                    visibleReceipts + " Receipts";

                itemSectionCount.textContent =
                    visibleItems + " Items";

            }


            /* =====================================================
               SHOW / HIDE EMPTY STATES
               ===================================================== */

            if (receiptSearchEmpty) {

                if (visibleReceipts === 0 &&
                    searchValue !== "") {

                    receiptSearchEmpty.style.display = "block";

                }
                else {

                    receiptSearchEmpty.style.display = "none";

                }

            }


            if (itemSearchEmpty) {

                if (visibleItems === 0 &&
                    searchValue !== "") {

                    itemSearchEmpty.style.display = "block";

                }
                else {

                    itemSearchEmpty.style.display = "none";

                }

            }


            /* =====================================================
               CLEAR BUTTON
               ===================================================== */

            if (searchValue.length > 0) {

                clearButton.style.display = "flex";

            }
            else {

                clearButton.style.display = "none";

            }


            /* =====================================================
               SEARCH RESULT MESSAGE
               ===================================================== */

            if (searchValue === "") {

                resultInfo.textContent =
                    "Showing all receipts and items";

            }
            else {

                resultInfo.textContent =
                    "Found " +
                    visibleReceipts +
                    " receipt(s) and " +
                    visibleItems +
                    " item(s)";

            }

        }


        /* =========================================================
           SEARCH WHILE TYPING
           ========================================================= */

        searchInput.addEventListener(
            "input",
            performSearch
        );


        /* =========================================================
           CLEAR SEARCH
           ========================================================= */

        clearButton.addEventListener(
            "click",
            function () {

                searchInput.value = "";

                performSearch();

                searchInput.focus();

            }
        );


        /* =========================================================
           ESCAPE KEY
           ========================================================= */

        searchInput.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    searchInput.value = "";

                    performSearch();

                }

            }
        );

    });

</script>