@model SmartTrack.ViewModels.EditReceiptViewModel

@{
    ViewData["Title"] = "Edit Receipt";
}

<style>

    /* =========================================================
           SMARTTRACK EDIT RECEIPT
           ========================================================= */

    .edit-page {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .edit-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .edit-title {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        color: #198754;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .edit-title-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #198754, #157347);
        color: white;
        font-size: 21px;
        box-shadow: 0 7px 20px rgba(25,135,84,.25);
    }

    .edit-description {
        color: #64748b;
        font-size: 14px;
        margin: 0 auto;
        max-width: 650px;
        line-height: 1.6;
    }


    /* =========================================================
           BACK BUTTON
           ========================================================= */

    .edit-back-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
    }

    .edit-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background: white;
        border: 1px solid #198754;
        color: #198754;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .25s ease;
        box-shadow: 0 3px 12px rgba(0,0,0,.06);
    }

        .edit-back-btn:hover {
            background: #198754;
            color: white;
            transform: translateY(-2px);
        }


    /* =========================================================
           COMMON CARD
           ========================================================= */

    .edit-card {
        background: #fff;
        border: 1px solid rgba(15,23,42,.06);
        border-radius: 20px;
        box-shadow: 0 5px 22px rgba(0,0,0,.06);
        margin-bottom: 24px;
        overflow: hidden;
        transition: .3s ease;
    }

        .edit-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
        }

    .edit-card-body {
        padding: 28px;
    }


    /* =========================================================
           SECTION HEADER
           ========================================================= */

    .edit-section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .edit-section-icon {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #e8f5ee;
        color: #198754;
        font-size: 18px;
    }

    .edit-section-title {
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        color: #0f172a;
    }

    .edit-section-subtitle {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 13px;
    }


    /* =========================================================
           RECEIPT INFORMATION
           ========================================================= */

    .receipt-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e8edf2;
        border-radius: 15px;
        padding: 17px;
    }

    .info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }

        .info-label i {
            color: #198754;
        }

    .info-value {
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
    }


    /* =========================================================
           ITEMS HEADER
           ========================================================= */

    .items-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

    .items-count {
        background: #e8f5ee;
        color: #198754;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           DESKTOP TABLE
           ========================================================= */

    .edit-table-wrapper {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        overflow-x: auto;
    }

    .edit-table {
        width: 100%;
        margin: 0;
        min-width: 850px;
    }

        .edit-table thead th {
            background: #e8f5ee;
            color: #14532d;
            border-bottom: 1px solid #cfe8d9;
            padding: 14px 12px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .edit-table tbody td {
            padding: 12px;
            vertical-align: middle;
            border-color: #eef1f3;
        }

        .edit-table tbody tr {
            transition: .2s ease;
        }

            .edit-table tbody tr:hover {
                background: #f8fcf9;
            }


    /* =========================================================
           INPUTS
           ========================================================= */

    .edit-input {
        width: 100%;
        border: 1px solid #dbe3e8;
        border-radius: 10px;
        padding: 9px 11px;
        font-size: 13px;
        transition: .2s ease;
    }

        .edit-input:focus {
            border-color: #198754;
            box-shadow: 0 0 0 .2rem rgba(25,135,84,.10);
            outline: none;
        }

        .edit-input[readonly] {
            background: #f8fafc;
        }


    /* =========================================================
           TOTAL PRICE
           ========================================================= */

    .total-price,
    .mobile-total-price {
        font-weight: 700;
    }

        .total-price:focus,
        .mobile-total-price:focus {
            border-color: #198754;
            background: #f8fff9;
        }


    /* =========================================================
           MOBILE ITEMS
           ========================================================= */

    .mobile-items {
        display: none;
    }

    .mobile-item-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        padding: 17px;
        margin-bottom: 14px;
        box-shadow: 0 3px 14px rgba(0,0,0,.04);
    }

    .mobile-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding-bottom: 13px;
        margin-bottom: 15px;
        border-bottom: 1px solid #edf0f2;
    }

    .mobile-item-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #198754;
        font-size: 16px;
        font-weight: 700;
    }

    .mobile-field {
        margin-bottom: 14px;
    }

        .mobile-field label {
            display: block;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 6px;
        }


    /* =========================================================
           GRAND TOTAL
           ========================================================= */

    .grand-total-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 22px;
        padding: 18px 20px;
        border-radius: 15px;
        background: linear-gradient(135deg,#f8fff9,#eefaf2);
        border: 1px solid #d7f0df;
    }

    .grand-total-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #475569;
        font-size: 14px;
        font-weight: 700;
    }

        .grand-total-label i {
            color: #198754;
        }

    .grand-total-value {
        color: #198754;
        font-size: 22px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .edit-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 24px;
    }

    .edit-action-btn {
        min-width: 170px;
        padding: 11px 22px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        transition: .25s ease;
    }

        .edit-action-btn:hover {
            transform: translateY(-2px);
        }

    .save-btn {
        box-shadow: 0 6px 17px rgba(25,135,84,.18);
    }

    .delete-receipt-area {
        display: flex;
        justify-content: flex-end;
        margin-top: 18px;
    }

    .delete-item-btn {
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        .edit-page {
            padding: 0 3px;
        }

        .edit-back-wrapper {
            justify-content: stretch;
        }

        .edit-back-btn {
            width: 100%;
            justify-content: center;
        }

        .edit-title {
            font-size: 23px;
        }

        .edit-title-icon {
            width: 40px;
            height: 40px;
            font-size: 18px;
            border-radius: 12px;
        }

        .edit-description {
            font-size: 12px;
            padding: 0 8px;
        }

        .edit-card {
            border-radius: 17px;
        }

        .edit-card-body {
            padding: 17px;
        }

        .edit-section-title {
            font-size: 17px;
        }

        .edit-section-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: 16px;
        }

        .receipt-info-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .items-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .items-count {
            align-self: flex-start;
        }

        .edit-table-wrapper {
            display: none;
        }

        .mobile-items {
            display: block;
        }

        .grand-total-box {
            flex-direction: column;
            align-items: flex-start;
            gap: 7px;
        }

        .grand-total-value {
            font-size: 20px;
        }

        .edit-actions {
            flex-direction: column-reverse;
            width: 100%;
        }

        .edit-action-btn {
            width: 100%;
        }

        .delete-receipt-area {
            justify-content: stretch;
        }

            .delete-receipt-area form {
                width: 100%;
            }

            .delete-receipt-area button {
                width: 100%;
            }
    }


    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 480px) {

        .edit-title {
            font-size: 21px;
        }

        .edit-card-body {
            padding: 14px;
        }

        .mobile-item-card {
            padding: 14px;
        }

        .mobile-item-title {
            font-size: 15px;
        }

        .info-box {
            padding: 14px;
        }

        .grand-total-box {
            padding: 15px;
        }
    }

</style>


<div class="container-fluid py-4">

    <div class="edit-page">


        <!-- =====================================================
             BACK BUTTON
        ====================================================== -->

        <div class="edit-back-wrapper">

            <a asp-action="ViewSavedReceipts"
               asp-controller="Receipt"
               class="edit-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Saved Receipts

            </a>

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="edit-header">

            <h2 class="edit-title">

                <span class="edit-title-icon">

                    <i class="bi bi-pencil-square"></i>

                </span>

                Edit Receipt

            </h2>

            <p class="edit-description">

                Update your receipt information and purchased items.

            </p>

        </div>


        <!-- =====================================================
             MAIN FORM
        ====================================================== -->

        <form asp-action="EditReceipt"
              asp-controller="Receipt"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ReceiptId" />

            <input type="hidden"
                   asp-for="PurchaseDate" />


            <!-- =================================================
                 RECEIPT INFORMATION
            ================================================== -->

            <div class="edit-card">

                <div class="edit-card-body">

                    <div class="edit-section-header">

                        <div class="edit-section-icon">

                            <i class="bi bi-receipt"></i>

                        </div>

                        <div>

                            <h4 class="edit-section-title">
                                Receipt Information
                            </h4>

                            <p class="edit-section-subtitle">
                                Basic information about this receipt.
                            </p>

                        </div>

                    </div>


                    <div class="receipt-info-grid">


                        <!-- DATE -->

                        <div class="info-box">

                            <div class="info-label">

                                <i class="bi bi-calendar3"></i>

                                Purchase Date

                            </div>

                            <div class="info-value">

                                @Model.PurchaseDate.ToString("dd/MM/yyyy")

                            </div>

                        </div>


                        <!-- RECEIPT ID -->

                        <div class="info-box">

                            <div class="info-label">

                                <i class="bi bi-hash"></i>

                                Receipt ID

                            </div>

                            <div class="info-value">

                                #@Model.ReceiptId

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 RECEIPT ITEMS
            ================================================== -->

            <div class="edit-card">

                <div class="edit-card-body">


                    <!-- ITEMS HEADER -->

                    <div class="items-header">

                        <div class="edit-section-header mb-0">

                            <div class="edit-section-icon">

                                <i class="bi bi-cart-check"></i>

                            </div>

                            <div>

                                <h4 class="edit-section-title">
                                    Receipt Items
                                </h4>

                                <p class="edit-section-subtitle">
                                    Update quantities, prices or item names.
                                </p>

                            </div>

                        </div>


                        <span class="items-count">

                            <i class="bi bi-box-seam me-1"></i>

                            @Model.Items.Count Items

                        </span>

                    </div>


                    <!-- =================================================
                         DESKTOP TABLE
                    ================================================== -->

                    <div class="edit-table-wrapper">

                        <table class="table edit-table">

                            <thead>

                                <tr>

                                    <th>
                                        Item Name
                                    </th>

                                    <th class="text-center">
                                        Quantity
                                    </th>

                                    <th class="text-center">
                                        Unit
                                    </th>

                                    <th class="text-end">
                                        Unit Price
                                    </th>

                                    <th class="text-end">
                                        Total Price
                                    </th>

                                    <th class="text-center">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @for (int i = 0;
                                                                i < Model.Items.Count;
                                                                i++)
                                {

                                    <tr>

                                        <td>

                                            <input type="hidden"
                                                   asp-for="Items[i].ReceiptItemId" />

                                            <input asp-for="Items[i].ItemName"
                                                   class="form-control edit-input item-name" />

                                        </td>


                                        <td>

                                            <input asp-for="Items[i].Quantity"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control edit-input quantity" />

                                        </td>


                                        <td>

                                            <input asp-for="Items[i].Unit"
                                                   class="form-control edit-input" />

                                        </td>


                                        <td>

                                            <input asp-for="Items[i].UnitPrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control edit-input unit-price text-end" />

                                        </td>


                                        <td>

                                            <input asp-for="Items[i].TotalPrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control edit-input total-price text-end" />

                                        </td>


                                        <td class="text-center">

                                            <a asp-action="DeleteReceiptItem"
                                               asp-route-id="@Model.Items[i].ReceiptItemId"
                                               asp-route-receiptId="@Model.ReceiptId"
                                               class="btn btn-sm btn-danger delete-item-btn"
                                               onclick="return confirm('Are you sure you want to delete this item?');">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- =================================================
                         MOBILE CARDS
                    ================================================== -->

                    <div class="mobile-items">

                        @for (int i = 0;
                                                i < Model.Items.Count;
                                                i++)
                        {

                            <div class="mobile-item-card">


                                <input type="hidden"
                                       asp-for="Items[i].ReceiptItemId" />


                                <div class="mobile-item-header">

                                    <span class="mobile-item-title">

                                        <i class="bi bi-cart3"></i>

                                        Item @(i + 1)

                                    </span>


                                    <span class="badge bg-light text-success">

                                        #@Model.Items[i].ReceiptItemId

                                    </span>

                                </div>


                                <!-- ITEM NAME -->

                                <div class="mobile-field">

                                    <label>
                                        Item Name
                                    </label>

                                    <input asp-for="Items[i].ItemName"
                                           class="form-control edit-input" />

                                </div>


                                <!-- QUANTITY -->

                                <div class="mobile-field">

                                    <label>
                                        Quantity
                                    </label>

                                    <input asp-for="Items[i].Quantity"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control edit-input mobile-quantity" />

                                </div>


                                <!-- UNIT -->

                                <div class="mobile-field">

                                    <label>
                                        Unit
                                    </label>

                                    <input asp-for="Items[i].Unit"
                                           class="form-control edit-input" />

                                </div>


                                <!-- UNIT PRICE -->

                                <div class="mobile-field">

                                    <label>
                                        Unit Price
                                    </label>

                                    <input asp-for="Items[i].UnitPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control edit-input mobile-unit-price" />

                                </div>


                                <!-- TOTAL PRICE -->

                                <div class="mobile-field">

                                    <label>
                                        Total Price
                                    </label>

                                    <input asp-for="Items[i].TotalPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control edit-input mobile-total-price" />

                                </div>


                                <!-- DELETE -->

                                <a asp-action="DeleteReceiptItem"
                                   asp-route-id="@Model.Items[i].ReceiptItemId"
                                   asp-route-receiptId="@Model.ReceiptId"
                                   class="btn btn-danger delete-item-btn w-100"
                                   onclick="return confirm('Are you sure you want to delete this item?');">

                                    <i class="bi bi-trash me-1"></i>

                                    Delete Item

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         GRAND TOTAL
                    ================================================== -->

                    <div class="grand-total-box">

                        <div class="grand-total-label">

                            <i class="bi bi-wallet2"></i>

                            Receipt Total

                        </div>

                        <div class="grand-total-value">

                            Rs <span id="grandTotal">0.00</span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ACTION BUTTONS
            ================================================== -->

            <div class="edit-actions">

                <a asp-action="ViewSavedReceipts"
                   asp-controller="Receipt"
                   class="btn btn-secondary edit-action-btn">

                    <i class="bi bi-arrow-left me-1"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-success edit-action-btn save-btn">

                    <i class="bi bi-check-circle me-1"></i>

                    Save Changes

                </button>

            </div>

        </form>


        <!-- =====================================================
             DELETE ENTIRE RECEIPT
        ====================================================== -->

        <div class="delete-receipt-area">

            <form asp-controller="Receipt"
                  asp-action="DeleteReceipt"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this entire receipt? This action cannot be undone.');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ReceiptId" />

                <button type="submit"
                        class="btn btn-outline-danger rounded-pill px-4">

                    <i class="bi bi-trash me-1"></i>

                    Delete Entire Receipt

                </button>

            </form>

        </div>


    </div>

</div>


<script>

    /* =========================================================
       CALCULATE ONE ITEM

       Total Price = Quantity × Unit Price
       ========================================================= */

    function calculateItemTotal(container) {

        const quantityInput =
            container.querySelector(".quantity") ||
            container.querySelector(".mobile-quantity");

        const unitPriceInput =
            container.querySelector(".unit-price") ||
            container.querySelector(".mobile-unit-price");

        const totalInput =
            container.querySelector(".total-price") ||
            container.querySelector(".mobile-total-price");


        if (!quantityInput ||
            !unitPriceInput ||
            !totalInput) {

            return;
        }


        const quantity =
            parseFloat(quantityInput.value) || 0;

        const unitPrice =
            parseFloat(unitPriceInput.value) || 0;


        const total =
            quantity * unitPrice;


        totalInput.value =
            total.toFixed(2);

    }


    /* =========================================================
       CALCULATE GRAND TOTAL
       ========================================================= */

    function calculateGrandTotal() {

        let grandTotal = 0;


        /*
         * DESKTOP
         */

        if (window.innerWidth > 767) {

            document
                .querySelectorAll(
                    ".edit-table-wrapper tbody tr"
                )
                .forEach(function (row) {

                    const totalInput =
                        row.querySelector(".total-price");

                    if (totalInput) {

                        grandTotal +=
                            parseFloat(totalInput.value) || 0;

                    }

                });

        }


        /*
         * MOBILE
         */

        else {

            document
                .querySelectorAll(".mobile-item-card")
                .forEach(function (card) {

                    const totalInput =
                        card.querySelector(
                            ".mobile-total-price"
                        );

                    if (totalInput) {

                        grandTotal +=
                            parseFloat(totalInput.value) || 0;

                    }

                });

        }


        /*
         * DISPLAY
         */

        const grandTotalElement =
            document.getElementById("grandTotal");


        if (grandTotalElement) {

            grandTotalElement.innerText =
                grandTotal.toLocaleString(
                    "en-US",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

        }

    }


    /* =========================================================
       DESKTOP QUANTITY CHANGE
       ========================================================= */

    document.addEventListener(
        "input",
        function (event) {

            if (
                event.target.classList.contains(
                    "quantity"
                )
            ) {

                const row =
                    event.target.closest("tr");

                if (row) {

                    calculateItemTotal(row);

                    calculateGrandTotal();

                }

            }


            /* =================================================
               DESKTOP UNIT PRICE CHANGE
               ================================================= */

            if (
                event.target.classList.contains(
                    "unit-price"
                )
            ) {

                const row =
                    event.target.closest("tr");

                if (row) {

                    calculateItemTotal(row);

                    calculateGrandTotal();

                }

            }


            /* =================================================
               MOBILE QUANTITY CHANGE
               ================================================= */

            if (
                event.target.classList.contains(
                    "mobile-quantity"
                )
            ) {

                const card =
                    event.target.closest(
                        ".mobile-item-card"
                    );

                if (card) {

                    calculateItemTotal(card);

                    calculateGrandTotal();

                }

            }


            /* =================================================
               MOBILE UNIT PRICE CHANGE
               ================================================= */

            if (
                event.target.classList.contains(
                    "mobile-unit-price"
                )
            ) {

                const card =
                    event.target.closest(
                        ".mobile-item-card"
                    );

                if (card) {

                    calculateItemTotal(card);

                    calculateGrandTotal();

                }

            }


            /* =================================================
               MANUAL TOTAL PRICE CHANGE
               ================================================= */

            if (
                event.target.classList.contains(
                    "total-price"
                ) ||
                event.target.classList.contains(
                    "mobile-total-price"
                )
            ) {

                calculateGrandTotal();

            }

        }
    );


    /* =========================================================
       INITIAL PAGE LOAD
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            /*
             * Calculate desktop item totals
             */

            document
                .querySelectorAll(
                    ".edit-table-wrapper tbody tr"
                )
                .forEach(function (row) {

                    calculateItemTotal(row);

                });


            /*
             * Calculate mobile item totals
             */

            document
                .querySelectorAll(
                    ".mobile-item-card"
                )
                .forEach(function (card) {

                    calculateItemTotal(card);

                });


            /*
             * Calculate grand total
             */

            calculateGrandTotal();

        }
    );


    /* =========================================================
       WINDOW RESIZE
       ========================================================= */

    window.addEventListener(
        "resize",
        function () {

            calculateGrandTotal();

        }
    );

</script>