@model SmartTrack.ViewModels.SaveReceiptViewModel

@{
    ViewData["Title"] = "Manual Receipt Entry";
}

<style>

    /* =========================================================
           SMARTTRACK MANUAL RECEIPT PAGE
           ========================================================= */

    .manual-receipt-page {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .manual-page-header {
        margin-bottom: 28px;
    }

    .manual-page-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 30px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 8px;
    }

    .manual-page-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #198754, #157347);
        color: #fff;
        font-size: 21px;
        box-shadow: 0 6px 18px rgba(25, 135, 84, 0.25);
    }

    .manual-page-description {
        max-width: 650px;
        margin: 0 auto;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
           BACK BUTTON
           ========================================================= */

    .manual-back-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 22px;
    }

    .manual-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 20px;
        background: #fff;
        color: #198754;
        border: 1.5px solid #198754;
        border-radius: 30px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
    }

        .manual-back-btn:hover {
            background: #198754;
            color: #fff;
            transform: translateY(-2px);
        }

    .back-arrow {
        font-size: 19px;
        transition: transform 0.25s ease;
    }

    .manual-back-btn:hover .back-arrow {
        transform: translateX(-4px);
    }


    /* =========================================================
           COMMON CARD
           ========================================================= */

    .manual-card {
        background: #fff;
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }

        .manual-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

    .manual-card-body {
        padding: 28px;
    }


    /* =========================================================
           SECTION HEADER
           ========================================================= */

    .manual-section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .manual-section-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f5ee;
        color: #198754;
        font-size: 18px;
    }

    .manual-section-title {
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        color: #0f172a;
    }

    .manual-section-subtitle {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 13px;
    }


    /* =========================================================
           FORM
           ========================================================= */

    .manual-form-label {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .manual-form-control {
        height: 45px;
        border-radius: 11px;
        border: 1px solid #dbe3e8;
        font-size: 14px;
    }

        .manual-form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.12);
        }


    /* =========================================================
           ITEMS HEADER
           ========================================================= */

    .items-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .add-item-btn {
        min-width: 135px;
        border-radius: 12px !important;
        font-weight: 600;
        transition: all 0.25s ease;
    }

        .add-item-btn:hover {
            transform: translateY(-2px);
        }


    /* =========================================================
           DESKTOP TABLE
           ========================================================= */

    .desktop-items-table {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }

        .desktop-items-table table {
            margin-bottom: 0;
            width: 100%;
        }

        .desktop-items-table thead th {
            background: #e8f5ee;
            color: #14532d;
            border-bottom: 1px solid #cfe8d9;
            padding: 13px 12px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .desktop-items-table tbody td {
            padding: 11px 10px;
            border-color: #eef1f3;
            vertical-align: middle;
        }

        .desktop-items-table tbody tr:hover {
            background: #f8fcf9;
        }

        .desktop-items-table input {
            min-height: 42px;
            border-radius: 9px;
            font-size: 13px;
        }

            .desktop-items-table input:focus {
                border-color: #198754;
                box-shadow: 0 0 0 0.15rem rgba(25, 135, 84, 0.10);
            }

    .remove-item {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px !important;
    }


    /* =========================================================
           MOBILE ITEMS
           ========================================================= */

    .mobile-items-container {
        display: none;
    }

    .mobile-item-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 17px;
        margin-bottom: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    }

    .mobile-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        margin-bottom: 15px;
        border-bottom: 1px solid #eef1f3;
    }

    .mobile-item-title {
        color: #198754;
        font-size: 15px;
        font-weight: 700;
    }

    .mobile-field {
        margin-bottom: 14px;
    }

        .mobile-field:last-child {
            margin-bottom: 0;
        }

        .mobile-field label {
            display: block;
            color: #475569;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .mobile-field input {
            width: 100%;
            height: 45px;
            border-radius: 10px;
            border: 1px solid #dbe3e8;
            font-size: 13px;
        }

            .mobile-field input:focus {
                border-color: #198754;
                box-shadow: 0 0 0 0.15rem rgba(25, 135, 84, 0.10);
            }


    /* =========================================================
           TOTAL
           ========================================================= */

    .receipt-total-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 22px;
    }

    .receipt-total-box {
        min-width: 230px;
        padding: 17px 22px;
        border-radius: 15px;
        background: #f8fff9;
        border: 1px solid #d8f3df;
        text-align: right;
    }

    .receipt-total-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .receipt-total-value {
        color: #198754;
        font-size: 22px;
        font-weight: 800;
    }


    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .action-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }

        .action-buttons .btn {
            min-height: 44px;
            border-radius: 12px !important;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

            .action-buttons .btn:hover {
                transform: translateY(-2px);
            }


    /* =========================================================
           VALIDATION
           ========================================================= */

    .validation-summary {
        border-radius: 12px;
    }


    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 992px) {

        .manual-receipt-page {
            max-width: 100%;
        }

        .manual-card-body {
            padding: 22px;
        }

        .manual-page-title {
            font-size: 27px;
        }

        .desktop-items-table {
            overflow-x: auto;
        }

            .desktop-items-table table {
                min-width: 850px;
            }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        .container-fluid {
            padding-left: 10px !important;
            padding-right: 10px !important;
        }

        .manual-receipt-page {
            width: 100%;
        }

        .manual-page-header {
            margin-bottom: 22px;
        }

        .manual-page-title {
            font-size: 23px;
            gap: 8px;
        }

        .manual-page-title-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 18px;
        }

        .manual-page-description {
            padding: 0 8px;
            font-size: 13px;
        }
        /* Back button */

        .manual-back-wrapper {
            width: 100%;
            justify-content: stretch;
            margin-bottom: 18px;
        }

        .manual-back-btn {
            width: 100%;
        }
        /* Cards */

        .manual-card {
            border-radius: 17px;
            margin-bottom: 18px;
        }

        .manual-card-body {
            padding: 17px;
        }
        /* Section */

        .manual-section-header {
            margin-bottom: 17px;
        }

        .manual-section-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: 16px;
        }

        .manual-section-title {
            font-size: 17px;
        }

        .manual-section-subtitle {
            font-size: 12px;
        }
        /* Date */

        .manual-form-control {
            height: 44px;
        }
        /* Items header */

        .items-header {
            flex-direction: column;
            align-items: stretch;
            gap: 14px;
        }

        .add-item-btn {
            width: 100%;
        }
        /* Hide desktop */

        .desktop-items-table {
            display: none;
        }
        /* Show mobile */

        .mobile-items-container {
            display: block;
        }
        /* Total */

        .receipt-total-wrapper {
            justify-content: stretch;
        }

        .receipt-total-box {
            width: 100%;
            min-width: 0;
            text-align: right;
        }
        /* Buttons */

        .action-buttons {
            flex-direction: column-reverse;
            width: 100%;
            gap: 10px;
        }

            .action-buttons .btn {
                width: 100%;
            }
    }


    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 480px) {

        .container-fluid {
            padding-left: 7px !important;
            padding-right: 7px !important;
        }

        .manual-page-title {
            font-size: 21px;
        }

        .manual-page-title-icon {
            width: 37px;
            height: 37px;
            font-size: 16px;
        }

        .manual-page-description {
            font-size: 12px;
        }

        .manual-card-body {
            padding: 14px;
        }

        .mobile-item-card {
            padding: 14px;
        }

        .mobile-field input {
            height: 44px;
        }

        .receipt-total-box {
            padding: 15px;
        }

        .receipt-total-value {
            font-size: 20px;
        }
    }

</style>


<div class="container-fluid py-4">

    <div class="manual-receipt-page">

        <!-- =====================================================
             BACK BUTTON
        ====================================================== -->

        <div class="manual-back-wrapper">

            <a asp-action="Scan"
               asp-controller="Receipt"
               class="manual-back-btn">

                <span class="back-arrow">←</span>

                <span>
                    Back to Scan Receipt
                </span>

            </a>

        </div>


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="manual-page-header text-center">

            <h2 class="manual-page-title">

                <span class="manual-page-title-icon">

                    <i class="fas fa-pen-to-square"></i>

                </span>

                Manual Receipt Entry

            </h2>

            <p class="manual-page-description">

                Enter your receipt details manually.

            </p>

        </div>


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-action="ManualEntry"
              asp-controller="Receipt"
              method="post">

            @Html.AntiForgeryToken()


            <!-- VALIDATION -->

            <div asp-validation-summary="All"
                 class="text-danger mb-3 validation-summary">
            </div>


            <!-- =================================================
                 RECEIPT INFORMATION
            ================================================== -->

            <div class="manual-card">

                <div class="manual-card-body">

                    <div class="manual-section-header">

                        <div class="manual-section-icon">

                            <i class="fas fa-receipt"></i>

                        </div>

                        <div>

                            <h4 class="manual-section-title">
                                Receipt Information
                            </h4>

                            <p class="manual-section-subtitle">
                                Enter the basic information for this receipt.
                            </p>

                        </div>

                    </div>


                    <div class="row">

                        <div class="col-12 col-md-6">

                            <label asp-for="Date"
                                   class="form-label manual-form-label">

                                Purchase Date

                            </label>

                            <input asp-for="Date"
                                   type="date"
                                   class="form-control manual-form-control" />

                            <span asp-validation-for="Date"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 RECEIPT ITEMS
            ================================================== -->

            <div class="manual-card">

                <div class="manual-card-body">

                    <!-- HEADER -->

                    <div class="items-header">

                        <div>

                            <div class="manual-section-header mb-0">

                                <div class="manual-section-icon">

                                    <i class="fas fa-cart-shopping"></i>

                                </div>

                                <div>

                                    <h4 class="manual-section-title">
                                        Receipt Items
                                    </h4>

                                    <p class="manual-section-subtitle">
                                        Add all items purchased.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <button type="button"
                                id="addItem"
                                class="btn btn-success add-item-btn">

                            <i class="fas fa-plus me-1"></i>

                            Add Item

                        </button>

                    </div>


                    <!-- =================================================
                         DESKTOP TABLE
                    ================================================== -->

                    <div class="desktop-items-table">

                        <table class="table align-middle">

                            <thead>

                                <tr>

                                    <th>
                                        Item Name
                                    </th>

                                    <th width="130">
                                        Quantity
                                    </th>

                                    <th width="130">
                                        Unit
                                    </th>

                                    <th width="160">
                                        Unit Price
                                    </th>

                                    <th width="160">
                                        Total Price
                                    </th>

                                    <th width="80"
                                        class="text-center">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="desktopItemsBody">

                                @for (int i = 0; i < Model.Items.Count; i++)
                                {

                                    <tr class="item-row"
                                        data-index="@i">

                                        <td>

                                            <input asp-for="Items[i].Name"
                                                   class="form-control"
                                                   placeholder="Item name"
                                                   required />

                                        </td>

                                        <td>

                                            <input asp-for="Items[i].Quantity"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control quantity"
                                                   placeholder="0" />

                                        </td>

                                        <td>

                                            <input asp-for="Items[i].Unit"
                                                   class="form-control"
                                                   placeholder="kg, pcs..." />

                                        </td>

                                        <td>

                                            <input asp-for="Items[i].UnitPrice"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control unit-price"
                                                   placeholder="0.00" />

                                        </td>

                                        <td>

                                            <input asp-for="Items[i].Price"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control total-price"
                                                   placeholder="0.00"
                                                   readonly />

                                        </td>

                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-danger remove-item">

                                                <i class="fas fa-trash"></i>

                                            </button>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- =================================================
                         MOBILE ITEMS
                    ================================================== -->

                    <div id="mobileItemsBody"
                         class="mobile-items-container">

                        @for (int i = 0; i < Model.Items.Count; i++)
                        {

                            <div class="mobile-item-card item-row"
                                 data-index="@i">

                                <div class="mobile-item-header">

                                    <span class="mobile-item-title">

                                        <i class="fas fa-cart-shopping me-1"></i>

                                        Item @(i + 1)

                                    </span>

                                    <button type="button"
                                            class="btn btn-danger remove-item">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </div>


                                <!-- ITEM NAME -->

                                <div class="mobile-field">

                                    <label>
                                        Item Name
                                    </label>

                                    <input name="Items[@i].Name"
                                           value="@Model.Items[i].Name"
                                           class="form-control mobile-name"
                                           placeholder="Enter item name"
                                           required />

                                </div>


                                <!-- QUANTITY -->

                                <div class="mobile-field">

                                    <label>
                                        Quantity
                                    </label>

                                    <input name="Items[@i].Quantity"
                                           value="@Model.Items[i].Quantity"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control mobile-quantity"
                                           placeholder="Enter quantity" />

                                </div>


                                <!-- UNIT -->

                                <div class="mobile-field">

                                    <label>
                                        Unit
                                    </label>

                                    <input name="Items[@i].Unit"
                                           value="@Model.Items[i].Unit"
                                           class="form-control mobile-unit"
                                           placeholder="kg, pcs, L..." />

                                </div>


                                <!-- UNIT PRICE -->

                                <div class="mobile-field">

                                    <label>
                                        Unit Price
                                    </label>

                                    <input name="Items[@i].UnitPrice"
                                           value="@Model.Items[i].UnitPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control mobile-unit-price"
                                           placeholder="0.00" />

                                </div>


                                <!-- TOTAL -->

                                <div class="mobile-field">

                                    <label>
                                        Total Price
                                    </label>

                                    <input name="Items[@i].Price"
                                           value="@Model.Items[i].Price"
                                           type="number"
                                           step="0.01"
                                           class="form-control mobile-total-price"
                                           placeholder="0.00"
                                           readonly />

                                </div>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         GRAND TOTAL
                    ================================================== -->

                    <div class="receipt-total-wrapper">

                        <div class="receipt-total-box">

                            <div class="receipt-total-label">
                                Receipt Total
                            </div>

                            <div class="receipt-total-value">

                                Rs <span id="grandTotal">0.00</span>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                    <div class="action-buttons">

                        <a asp-action="ViewSavedReceipts"
                           asp-controller="Receipt"
                           class="btn btn-secondary">

                            <i class="fas fa-arrow-left me-1"></i>

                            Cancel

                        </a>


                        <button type="submit"
                                id="saveReceiptBtn"
                                class="btn btn-success">

                            <i class="fas fa-floppy-disk me-1"></i>

                            Save Receipt

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


<script>

    let itemIndex = @Model.Items.Count;


    /* =========================================================
       ENABLE ONLY CURRENT DEVICE INPUTS
    ========================================================= */

    function updateFormInputs() {

        const isMobile = window.innerWidth <= 767;


        /*
         * Desktop inputs
         */

        document
            .querySelectorAll("#desktopItemsBody input")
            .forEach(function (input) {

                input.disabled = isMobile;

            });


        document
            .querySelectorAll("#desktopItemsBody .remove-item")
            .forEach(function (button) {

                button.disabled = isMobile;

            });


        /*
         * Mobile inputs
         */

        document
            .querySelectorAll("#mobileItemsBody input")
            .forEach(function (input) {

                input.disabled = !isMobile;

            });


        document
            .querySelectorAll("#mobileItemsBody .remove-item")
            .forEach(function (button) {

                button.disabled = !isMobile;

            });

    }


    /* =========================================================
       ADD ITEM
    ========================================================= */

    document
        .getElementById("addItem")
        .addEventListener("click", function () {

            const desktopBody =
                document.getElementById("desktopItemsBody");

            const mobileBody =
                document.getElementById("mobileItemsBody");


            /*
             * DESKTOP ROW
             */

            const desktopRow =
                document.createElement("tr");

            desktopRow.classList.add("item-row");

            desktopRow.setAttribute(
                "data-index",
                itemIndex
            );


            desktopRow.innerHTML = `

                <td>

                    <input type="text"
                           name="Items[${itemIndex}].Name"
                           class="form-control"
                           placeholder="Item name"
                           required>

                </td>

                <td>

                    <input type="number"
                           name="Items[${itemIndex}].Quantity"
                           class="form-control quantity"
                           step="0.01"
                           min="0"
                           placeholder="0">

                </td>

                <td>

                    <input type="text"
                           name="Items[${itemIndex}].Unit"
                           class="form-control"
                           placeholder="kg, pcs...">

                </td>

                <td>

                    <input type="number"
                           name="Items[${itemIndex}].UnitPrice"
                           class="form-control unit-price"
                           step="0.01"
                           min="0"
                           placeholder="0.00">

                </td>

                <td>

                    <input type="number"
                           name="Items[${itemIndex}].Price"
                           class="form-control total-price"
                           step="0.01"
                           min="0"
                           placeholder="0.00"
                           readonly>

                </td>

                <td class="text-center">

                    <button type="button"
                            class="btn btn-danger remove-item">

                        <i class="fas fa-trash"></i>

                    </button>

                </td>

            `;


            desktopBody.appendChild(desktopRow);


            /*
             * MOBILE CARD
             */

            const mobileCard =
                document.createElement("div");

            mobileCard.classList.add(
                "mobile-item-card",
                "item-row"
            );

            mobileCard.setAttribute(
                "data-index",
                itemIndex
            );


            mobileCard.innerHTML = `

                <div class="mobile-item-header">

                    <span class="mobile-item-title">

                        <i class="fas fa-cart-shopping me-1"></i>

                        Item ${itemIndex + 1}

                    </span>

                    <button type="button"
                            class="btn btn-danger remove-item">

                        <i class="fas fa-trash"></i>

                    </button>

                </div>


                <div class="mobile-field">

                    <label>
                        Item Name
                    </label>

                    <input type="text"
                           name="Items[${itemIndex}].Name"
                           class="form-control mobile-name"
                           placeholder="Enter item name"
                           required>

                </div>


                <div class="mobile-field">

                    <label>
                        Quantity
                    </label>

                    <input type="number"
                           name="Items[${itemIndex}].Quantity"
                           class="form-control mobile-quantity"
                           step="0.01"
                           min="0"
                           placeholder="Enter quantity">

                </div>


                <div class="mobile-field">

                    <label>
                        Unit
                    </label>

                    <input type="text"
                           name="Items[${itemIndex}].Unit"
                           class="form-control mobile-unit"
                           placeholder="kg, pcs, L...">

                </div>


                <div class="mobile-field">

                    <label>
                        Unit Price
                    </label>

                    <input type="number"
                           name="Items[${itemIndex}].UnitPrice"
                           class="form-control mobile-unit-price"
                           step="0.01"
                           min="0"
                           placeholder="0.00">

                </div>


                <div class="mobile-field">

                    <label>
                        Total Price
                    </label>

                    <input type="number"
                           name="Items[${itemIndex}].Price"
                           class="form-control mobile-total-price"
                           step="0.01"
                           readonly>

                </div>

            `;


            mobileBody.appendChild(mobileCard);


            itemIndex++;

            updateFormInputs();

            calculateTotal();

        });


    /* =========================================================
       REMOVE ITEM
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(".remove-item");

            if (!button)
                return;


            const item =
                button.closest(".item-row");

            if (!item)
                return;


            const index =
                item.getAttribute("data-index");

            if (index === null)
                return;


            /*
             * Remove desktop version
             */

            document
                .querySelectorAll(
                    "#desktopItemsBody .item-row"
                )
                .forEach(function (row) {

                    if (
                        row.getAttribute("data-index") === index
                    ) {

                        row.remove();

                    }

                });


            /*
             * Remove mobile version
             */

            document
                .querySelectorAll(
                    "#mobileItemsBody .item-row"
                )
                .forEach(function (card) {

                    if (
                        card.getAttribute("data-index") === index
                    ) {

                        card.remove();

                    }

                });


            calculateTotal();

            updateFormInputs();

        }
    );


    /* =========================================================
       INPUT CALCULATION
    ========================================================= */

    document.addEventListener(
        "input",
        function (event) {


            /*
             * DESKTOP
             */

            if (
                event.target.classList.contains("quantity") ||
                event.target.classList.contains("unit-price")
            ) {

                const row =
                    event.target.closest("tr");

                if (row) {

                    const quantity =
                        parseFloat(
                            row.querySelector(".quantity").value
                        ) || 0;

                    const unitPrice =
                        parseFloat(
                            row.querySelector(".unit-price").value
                        ) || 0;

                    row.querySelector(".total-price").value =
                        (quantity * unitPrice).toFixed(2);

                }

            }


            /*
             * MOBILE
             */

            if (
                event.target.classList.contains("mobile-quantity") ||
                event.target.classList.contains("mobile-unit-price")
            ) {

                const card =
                    event.target.closest(".mobile-item-card");

                if (card) {

                    const quantity =
                        parseFloat(
                            card.querySelector(
                                ".mobile-quantity"
                            ).value
                        ) || 0;

                    const unitPrice =
                        parseFloat(
                            card.querySelector(
                                ".mobile-unit-price"
                            ).value
                        ) || 0;

                    card.querySelector(
                        ".mobile-total-price"
                    ).value =
                        (quantity * unitPrice).toFixed(2);

                }

            }


            calculateTotal();

        }
    );


    /* =========================================================
       CALCULATE GRAND TOTAL
    ========================================================= */

    function calculateTotal() {

        let total = 0;

        const isMobile =
            window.innerWidth <= 767;


        if (isMobile) {

            document
                .querySelectorAll(
                    "#mobileItemsBody .mobile-total-price"
                )
                .forEach(function (input) {

                    total +=
                        parseFloat(input.value) || 0;

                });

        }
        else {

            document
                .querySelectorAll(
                    "#desktopItemsBody .total-price"
                )
                .forEach(function (input) {

                    total +=
                        parseFloat(input.value) || 0;

                });

        }


        const grandTotal =
            document.getElementById("grandTotal");


        if (grandTotal) {

            grandTotal.innerText =
                total.toFixed(2);

        }

    }


    /* =========================================================
       SCREEN SIZE CHANGE
    ========================================================= */

    window.addEventListener(
        "resize",
        function () {

            updateFormInputs();

            calculateTotal();

        }
    );


    /* =========================================================
       INITIAL LOAD
    ========================================================= */

    updateFormInputs();

    calculateTotal();

</script>