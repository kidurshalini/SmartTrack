@model SmartTrack.Models.OCRResponseModel

@{
    ViewData["Title"] = "Scan Receipt";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-success">
            <i class="bi bi-receipt"></i> Scan Receipt
        </h2>
        <p class="text-muted">
            Upload your receipt and let SmartTrack automatically extract the purchase details.
        </p>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Upload Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-cloud-upload text-success me-2"></i>
                Upload Receipt
            </h5>

            <form asp-action="Scan"
                  method="post"
                  enctype="multipart/form-data">

                <div class="upload-box text-center p-4">

                    <i class="bi bi-receipt-cutoff upload-icon"></i>

                    <h5 class="mt-3">
                        Select your receipt image
                    </h5>

                    <p class="text-muted">
                        Supported formats: JPG, JPEG, PNG
                    </p>

                    <input type="file"
                           name="image"
                           id="receiptImage"
                           class="form-control"
                           accept=".jpg,.jpeg,.png"
                           required />

                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">

                    <button type="submit"
                            class="btn btn-success btn-lg px-5 rounded-pill">

                        <i class="bi bi-search me-2"></i>
                        Scan Receipt

                    </button>


                    <a asp-controller="Receipt"
                       asp-action="ManualEntry"
                       class="btn btn-primary btn-lg px-5 rounded-pill">

                        <i class="bi bi-pencil-square me-2"></i>
                        Manual Entry

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- Extracted Results -->
    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-4">

                <!-- Result Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h4 class="fw-bold text-success mb-1">
                            <i class="bi bi-check-circle me-2"></i>
                            Receipt Scanned Successfully
                        </h4>

                        <p class="text-muted mb-0">
                            The following information was extracted from your receipt.
                        </p>
                    </div>

                    <span class="badge bg-success fs-6 px-3 py-2">
                        @Model.Items.Count Items
                    </span>

                </div>


                <!-- Purchase Date -->
                <div class="info-box mb-4">

                    <div class="row">

                        <div class="col-md-6">
                            <strong>
                                <i class="bi bi-calendar3 me-2"></i>
                                Purchase Date
                            </strong>
                        </div>

                        <div class="col-md-6 text-md-end">

                            @(Model.Date.HasValue
                                                    ? Model.Date.Value.ToString("yyyy-MM-dd")
                                                    : "Not detected")

                    </div>

                    </div>

                </div>


                <!-- Items Table -->
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-success">

                            <tr>

                                <th>#</th>

                                <th>
                                    Product Name
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Price
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        @{
                                int itemNumber = 1;
                            }

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @itemNumber
                                    </td>

                                    <td class="fw-semibold">
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.Quantity @item.Unit
                                    </td>

                                    <td>
                                        Rs @item.UnitPrice.ToString("0.00")
                                    </td>

                                    <td class="fw-semibold">
                                        Rs @item.Price.ToString("0.00")
                                    </td>

                                </tr>

                                itemNumber++;
                            }

                        </tbody>


                        <tfoot>

                            <tr class="table-light">

                                <th colspan="4"
                                    class="text-end fs-5">

                                    Total Amount

                                </th>

                                <th class="text-success fs-5">

                                    Rs @Model.TotalAmount.ToString("0.00")

                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>


                <!-- Save Receipt -->
                <form asp-action="SaveReceipt"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to save this receipt?');">

                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <input type="hidden"
                               name="Items[@i].Name"
                               value="@Model.Items[i].Name" />

                        <input type="hidden"
                               name="Items[@i].Quantity"
                               value="@Model.Items[i].Quantity" />

                        <input type="hidden"
                               name="Items[@i].Unit"
                               value="@Model.Items[i].Unit" />

                        <input type="hidden"
                               name="Items[@i].UnitPrice"
                               value="@Model.Items[i].UnitPrice" />

                        <input type="hidden"
                               name="Items[@i].Price"
                               value="@Model.Items[i].Price" />
                    }

                    <input type="hidden"
                           name="Date"
                           value="@Model.Date" />


                    <div class="text-center mt-4">

                        <button type="submit"
                                class="btn btn-primary btn-lg px-5 rounded-pill">

                            <i class="bi bi-save me-2"></i>
                            Save Receipt

                        </button>

                      
                    </div>

                </form>

            </div>

        </div>
    }


</div>


<style>

    .upload-box {
        border: 2px dashed #198754;
        border-radius: 15px;
        background-color: #f8fff9;
        transition: 0.3s;
    }

        .upload-box:hover {
            background-color: #effaf2;
            border-color: #146c43;
        }

    .upload-icon {
        font-size: 55px;
        color: #198754;
    }

    .info-box {
        background: #f8f9fa;
        border-left: 5px solid #198754;
        padding: 15px 20px;
        border-radius: 8px;
    }

    .table {
        border-radius: 10px;
        overflow: hidden;
    }

    .card {
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

</style>