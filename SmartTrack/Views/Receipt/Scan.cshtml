@model SmartTrack.Models.OCRResponseModel

@{
    ViewData["Title"] = "Scan Receipt";
}

<div class="container py-5">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="text-center mb-4">

        <h2 class="fw-bold text-success">

            <i class="bi bi-receipt"></i>

            Scan Receipt

        </h2>

        <p class="text-muted">

            Upload your receipt and let SmartTrack automatically
            extract the purchase details.

        </p>

    </div>


    <!-- =====================================================
         SUCCESS MESSAGE
    ====================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>Success!</strong>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         UPLOAD CARD
    ====================================================== -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-cloud-upload text-success me-2"></i>

                Upload Receipt

            </h5>


            <form asp-action="Scan"
                  method="post"
                  enctype="multipart/form-data">


                <div class="upload-box text-center p-4">

                    <i class="bi bi-receipt-cutoff upload-icon"></i>


                    <h5 class="mt-3">

                        Select your receipt image

                    </h5>


                    <p class="text-muted">

                        Supported formats: JPG, JPEG, PNG

                    </p>


                    <input type="file"
                           name="image"
                           id="receiptImage"
                           class="form-control"
                           accept=".jpg,.jpeg,.png"
                           required />

                </div>


                <!-- BUTTONS -->

                <div class="d-flex justify-content-center gap-3 mt-4">


                    <button type="submit"
                            class="btn btn-success btn-lg px-5 rounded-pill">

                        <i class="bi bi-search me-2"></i>

                        Scan Receipt

                    </button>


                    <a asp-controller="Receipt"
                       asp-action="ManualEntry"
                       class="btn btn-primary btn-lg px-5 rounded-pill">

                        <i class="bi bi-pencil-square me-2"></i>

                        Manual Entry

                    </a>


                </div>

            </form>

        </div>

    </div>



    <!-- =====================================================
         EXTRACTED RESULTS
    ====================================================== -->

    @if (Model != null &&
         Model.Items != null &&
         Model.Items.Any())
    {

        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-4">


                <!-- =================================================
                     RESULT HEADER
                ================================================== -->

                <div class="d-flex justify-content-between
                            align-items-center mb-4">


                    <div>

                        <h4 class="fw-bold text-success mb-1">

                            <i class="bi bi-check-circle me-2"></i>

                            Receipt Scanned Successfully

                        </h4>


                        <p class="text-muted mb-0">

                            The following information was extracted
                            from your receipt.

                        </p>

                    </div>


                    <span class="badge bg-success fs-6 px-3 py-2">

                        @Model.Items.Count Items

                    </span>

                </div>



                <!-- =================================================
                     PURCHASE DATE
                ================================================== -->

                <div class="info-box mb-4">

                    <div class="row">


                        <div class="col-md-6">

                            <strong>

                                <i class="bi bi-calendar3 me-2"></i>

                                Purchase Date

                            </strong>

                        </div>


                        <div class="col-md-6 text-md-end">

                            @(Model.Date.HasValue
                                                    ? Model.Date.Value.ToString("dd/MM/yyyy")
                                                    : "Not detected")

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     ITEMS TABLE
                ================================================== -->

                <div class="table-responsive">


                    <table class="table table-hover
                                  align-middle
                                  receipt-table">


                        <!-- TABLE HEADER -->

                        <thead class="table-success">

                            <tr>

                                <th class="text-center">
                                    #
                                </th>


                                <th>
                                    Product Name
                                </th>


                                <!-- SEPARATE QUANTITY -->

                                <th class="text-center">
                                    Quantity
                                </th>


                                <!-- SEPARATE UNIT -->

                                <th class="text-center">
                                    Unit
                                </th>


                                <th class="text-end">
                                    Unit Price
                                </th>


                                <th class="text-end">
                                    Total Price
                                </th>

                            </tr>

                        </thead>



                        <!-- TABLE BODY -->

                        <tbody>

                            @{
                                int itemNumber = 1;
                            }


                            @foreach (var item in Model.Items)
                            {

                                <tr>


                                    <!-- NUMBER -->

                                    <td class="text-center">

                                        @itemNumber

                                    </td>


                                    <!-- PRODUCT -->

                                    <td class="fw-semibold">

                                        @item.Name

                                    </td>


                                    <!-- QUANTITY -->

                                    <td class="text-center">

                                        <span class="quantity-badge">

                                            @item.Quantity

                                        </span>

                                    </td>


                                    <!-- UNIT -->

                                    <td class="text-center">

                                        @if (!string.IsNullOrWhiteSpace(item.Unit))
                                        {

                                            <span class="unit-badge">

                                                @item.Unit

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="text-muted">

                                                -

                                            </span>

                                        }

                                    </td>


                                    <!-- UNIT PRICE -->

                                    <td class="text-end">

                                        Rs
                                        @item.UnitPrice.ToString("N2")

                                    </td>


                                    <!-- TOTAL -->

                                    <td class="text-end fw-semibold">

                                        Rs
                                        @item.Price.ToString("N2")

                                    </td>


                                </tr>


                                itemNumber++;

                            }

                        </tbody>



                        <!-- =================================================
                             TOTAL
                        ================================================== -->

                        <tfoot>

                            <tr class="table-light">


                                <th colspan="5"
                                    class="text-end fs-5">

                                    Total Amount

                                </th>


                                <th class="text-success
                                           text-end
                                           fs-5">

                                    Rs
                                    @Model.TotalAmount.ToString("N2")

                                </th>


                            </tr>

                        </tfoot>


                    </table>

                </div>



                <!-- =================================================
                     SAVE RECEIPT
                ================================================== -->

                <form asp-action="SaveReceipt"
                      method="post"
                      onsubmit="return confirm(
                          'Are you sure you want to save this receipt?'
                      );">


                    <!-- =============================================
                         SAVE EACH ITEM
                    ============================================== -->

                    @for (int i = 0;
                          i < Model.Items.Count;
                          i++)
                    {

                        <!-- PRODUCT NAME -->

                        <input type="hidden"
                               name="Items[@i].Name"
                               value="@Model.Items[i].Name" />


                        <!-- QUANTITY
                             SAVED SEPARATELY -->

                        <input type="hidden"
                               name="Items[@i].Quantity"
                               value="@Model.Items[i].Quantity" />


                        <!-- UNIT
                             SAVED SEPARATELY -->

                        <input type="hidden"
                               name="Items[@i].Unit"
                               value="@Model.Items[i].Unit" />


                        <!-- UNIT PRICE -->

                        <input type="hidden"
                               name="Items[@i].UnitPrice"
                               value="@Model.Items[i].UnitPrice" />


                        <!-- TOTAL PRICE -->

                        <input type="hidden"
                               name="Items[@i].Price"
                               value="@Model.Items[i].Price" />

                    }


                    <!-- PURCHASE DATE -->

                    <input type="hidden"
                           name="Date"
                           value="@Model.Date" />



                    <!-- SAVE BUTTON -->

                    <div class="text-center mt-4">


                        <button type="submit"
                                class="btn btn-primary
                                       btn-lg
                                       px-5
                                       rounded-pill">


                            <i class="bi bi-save me-2"></i>

                            Save Receipt

                        </button>


                    </div>


                </form>


            </div>

        </div>

    }

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

    /* =========================================
       UPLOAD BOX
    ========================================== */

    .upload-box {

        border: 2px dashed #198754;

        border-radius: 15px;

        background-color: #f8fff9;

        transition: 0.3s;

    }


    .upload-box:hover {

        background-color: #effaf2;

        border-color: #146c43;

    }


    /* =========================================
       UPLOAD ICON
    ========================================== */

    .upload-icon {

        font-size: 55px;

        color: #198754;

    }


    /* =========================================
       DATE INFORMATION BOX
    ========================================== */

    .info-box {

        background: #f8f9fa;

        border-left: 5px solid #198754;

        padding: 15px 20px;

        border-radius: 8px;

    }


    /* =========================================
       TABLE
    ========================================== */

    .receipt-table {

        border-radius: 10px;

        overflow: hidden;

        margin-bottom: 0;

    }


    .receipt-table th {

        white-space: nowrap;

    }


    .receipt-table td {

        vertical-align: middle;

    }


    /* =========================================
       QUANTITY BADGE
    ========================================== */

    .quantity-badge {

        display: inline-block;

        min-width: 45px;

        padding: 5px 10px;

        border-radius: 20px;

        background-color: #e8f5e9;

        color: #198754;

        font-weight: 600;

    }


    /* =========================================
       UNIT BADGE
    ========================================== */

    .unit-badge {

        display: inline-block;

        padding: 5px 12px;

        border-radius: 20px;

        background-color: #f1f3f5;

        color: #495057;

        font-weight: 500;

    }


    /* =========================================
       CARD
    ========================================== */

    .card {

        transition: 0.3s;

    }


    .card:hover {

        transform: translateY(-2px);

    }


</style>