@model SmartTrack.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Accountlayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="login-container">

    <div class="login-card">

        <!-- Logo -->
        <div class="logo-section">
            <img src="~/image/logo1.png" class="smart-logo" alt="SmartTrack Logo" />
            <p class="brand-tag mt-2">Smart Household Inventory Management</p>
        </div>

        <form asp-action="Login" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <!-- ─── Email ─── -->
            <div class="form-group">
                <label class="field-label" asp-for="Email">
                    Email Address   
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <!-- ─── Password ─── -->
            <div class="form-group">
                <label class="field-label" asp-for="Password">
                    Password   
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="LoginPassword" type="password" placeholder="••••••••" />
                    <button type="button" class="toggle-pwd" id="loginEye" onclick="togglePassword('LoginPassword','loginEye')">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>

            <!-- ─── Utility Links ─── -->
            <div class="utility-links">
                <a asp-controller="Account" asp-action="ForgotPassword">
                    <i class="bi bi-key"></i> Forgot Password?
                </a>
               
                <div>
                    <span style="color: #6c859e;">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="create-account">
                        Create Account <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- ─── Login Button ─── -->
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i>
                Login
            </button>

        </form>

    </div>
</div>

<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        icon.innerHTML = isPassword ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const emailInput = document.getElementById('Email');
        if (emailInput) setTimeout(() => emailInput.focus(), 400);
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}