@model SmartTrack.ViewModel.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Accountlayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="login-container">
    <div class="login-card">

    
        <div class="logo-section">
            <img src="~/image/logo1.png" class="smart-logo" alt="SmartTrack Logo" />
            <p class="brand-tag">Smart Household Inventory Management</p>
        </div>

        <form asp-action="ForgotPassword" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="field-label" asp-for="Email">
                    Email Address
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="utility-links">
                <a asp-action="Login">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-send"></i>
                Send OTP
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}