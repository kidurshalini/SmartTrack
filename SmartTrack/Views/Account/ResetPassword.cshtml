@model SmartTrack.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Accountlayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="login-container">
    <div class="login-card">

       
        <div class="logo-section">
            <img src="~/image/logo1.png" class="smart-logo" alt="SmartTrack Logo" />
            <p class="brand-tag">Smart Household Inventory Management</p>
        </div>

        <form asp-action="ResetPassword" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <input asp-for="Email" type="hidden" />

            <div class="form-group">
                <label class="field-label" asp-for="NewPassword">
                    New Password
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="NewPassword" id="NewPassword" type="password" placeholder="Enter New Password" />
                    <button type="button" class="toggle-pwd" id="newPasswordEye" onclick="togglePassword('NewPassword','newPasswordEye')">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label class="field-label" asp-for="ConfirmPassword">
                    Confirm Password
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" placeholder="Confirm Password" />
                    <button type="button" class="toggle-pwd" id="confirmPasswordEye" onclick="togglePassword('ConfirmPassword','confirmPasswordEye')">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
            </div>

          
            <div class="utility-links">
                <a asp-action="Login">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>

            <button type="submit" class="btn-login">
                <i class="bi bi-check-circle"></i>
                Update Password
            </button>

        </form>

    </div>
</div>

<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        icon.innerHTML = isPassword ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const firstInput = document.querySelector('.input-box input');
        if (firstInput) {
            setTimeout(() => firstInput.focus(), 400);
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}