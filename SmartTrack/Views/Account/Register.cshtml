@model SmartTrack.ViewModels.HouseholdRegisterViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Accountlayout.cshtml";
}

<div class="register-container">
    <div class="register-card">

        <!-- Logo -->
        <div class="logo-section">
            <img src="~/image/logo1.png" class="smart-logo" alt="SmartTrack Logo" />
            <p class="brand-tag">Smart Household Inventory Management System</p>
        </div>

        <!-- Progress Steps -->
        <div class="progress-steps">
            <span class="step-item done">
                <span class="step-num"><i class="bi bi-check-lg"></i></span>
                Home
            </span>
            <span class="step-line done"></span>
            <span class="step-item active">
                <span class="step-num">2</span>
                Owner
            </span>
            <span class="step-line"></span>
            <span class="step-item">
                <span class="step-num">3</span>
                Members
            </span>
        </div>

        <form asp-action="Register" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="validation-error" style="margin-bottom: 16px; font-size:14px;"></div>

            <!-- ═══ HOME DETAILS ═══ -->
            <div class="section-title">
                <span class="title-line" style="flex:0 0 0;"></span>
                Home Details
                <span class="title-badge">Step 1</span>
                <span class="title-line"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="field-label" asp-for="HouseHoldName">
                        House Name <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-house"></i></span>
                        <input asp-for="HouseHoldName" placeholder="e.g. Green Villa" />
                    </div>
                    <span asp-validation-for="HouseHoldName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="field-label" asp-for="TotalMembers">
                        Total Members <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-people"></i></span>
                        <input asp-for="TotalMembers" type="number" placeholder="e.g. 4" min="1" />
                    </div>
                    <span asp-validation-for="TotalMembers" class="validation-error"></span>
                </div>
            </div>

            <!-- ═══ OWNER DETAILS ═══ -->
            <div class="section-title" style="margin-top:32px;">
                <span class="title-icon"><i class="bi bi-person-circle"></i></span>
                Owner Details
                <span class="title-badge">Step 2</span>
                <span class="title-line"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="field-label" asp-for="OwnerUserName">
                        Username <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-person"></i></span>
                        <input asp-for="OwnerUserName" placeholder="Choose a username" />
                    </div>
                    <span asp-validation-for="OwnerUserName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="field-label" asp-for="OwnerEmailId">
                        Email Address <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-envelope"></i></span>
                        <input asp-for="OwnerEmailId" type="email" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="OwnerEmailId" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="field-label" asp-for="OwnerPhoneNumber">
                        Phone Number <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-telephone"></i></span>
                        <input asp-for="OwnerPhoneNumber" placeholder="0771234567" />
                    </div>
                    <span asp-validation-for="OwnerPhoneNumber" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label class="field-label" asp-for="OwnerPassword">
                        Password <span class="required">*</span>
                    </label>
                    <div class="input-box">
                        <span class="input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="OwnerPassword" id="OwnerPassword" type="password" placeholder="••••••••" />
                        <button type="button" class="toggle-pwd" id="ownerEye" onclick="togglePassword('OwnerPassword','ownerEye')">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="OwnerPassword" class="validation-error"></span>
                </div>
            </div>

            <!-- ═══ FAMILY MEMBERS ═══ -->
            <div class="section-title" style="margin-top:32px;">
                <span class="title-icon"><i class="bi bi-people-fill"></i></span>
                Family Members
                <span class="title-badge">Step 3</span>
                <span class="title-line"></span>
            </div>

            <div id="members"></div>

            <button type="button" class="btn-add-member" onclick="addMember()">
                <i class="bi bi-person-plus"></i>
                Add Member
            </button>

            <!-- ═══ ACTION BUTTONS ═══ -->
            <div class="action-buttons">
                <button type="submit" class="btn-primary-action btn-submit">
                    <i class="bi bi-check-circle"></i>
                    Save Household
                </button>
                <button type="reset" class="btn-primary-action btn-reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </button>
            </div>

        </form>

    </div>
</div>

<script>
    let memberIndex = 0;

    function addMember() {
        const idx = memberIndex;

        const html = `
                <div class="member-card" id="member-${idx}">
                    <div class="member-header">
                        <div class="member-avatar">
                            <span class="avatar-circle">${idx + 1}</span>
                            <span class="member-label">
                                Member ${idx + 1}
                            </span>
                        </div>
                        <button type="button" class="btn-remove-member" onclick="removeMember(${idx})">
                            <i class="bi bi-person-x"></i> Remove
                        </button>
                    </div>

                    <div class="member-form-grid">
                        <div class="form-group">
                            <label class="field-label">Username</label>
                            <div class="input-box">
                                <span class="input-icon"><i class="bi bi-person"></i></span>
                                <input name="Members[${idx}].UserName" placeholder="Username" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="field-label">Email</label>
                            <div class="input-box">
                                <span class="input-icon"><i class="bi bi-envelope"></i></span>
                                <input name="Members[${idx}].EmailId" type="email" placeholder="Email" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="field-label">Phone</label>
                            <div class="input-box">
                                <span class="input-icon"><i class="bi bi-telephone"></i></span>
                                <input name="Members[${idx}].PhoneNumber" placeholder="Phone Number" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="field-label">Password</label>
                            <div class="input-box">
                                <span class="input-icon"><i class="bi bi-lock"></i></span>
                                <input name="Members[${idx}].Password" id="MemberPassword${idx}" type="password" placeholder="••••••••" />
                                <button type="button" class="toggle-pwd" id="memberEye${idx}" onclick="togglePassword('MemberPassword${idx}','memberEye${idx}')">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label class="field-label">Role</label>
                            <div class="input-box">
                                <span class="input-icon"><i class="bi bi-person-gear"></i></span>
                                <select name="Members[${idx}].Role" class="form-select" style="padding-left: 42px; padding-right: 2.5rem; border: none; background: transparent; box-shadow: none; height: 46px;">
                                    <option value="FamilyMembers">Family Member</option>
                                    <option value="HouseMaid">House Maid</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            `;

        document.getElementById('members').insertAdjacentHTML('beforeend', html);
        memberIndex++;
    }

    function removeMember(id) {
        const el = document.getElementById('member-' + id);
        if (el) {
            el.style.transform = 'scale(0.95)';
            el.style.opacity = '0';
            setTimeout(() => {
                el.remove();
                document.querySelectorAll('.member-card .avatar-circle').forEach((circle, i) => {
                    circle.textContent = i + 1;
                });
                document.querySelectorAll('.member-card .member-label').forEach((label, i) => {
                    label.innerHTML = `Member ${i + 1}`;
                });
                memberIndex = document.querySelectorAll('.member-card').length;
            }, 200);
        }
    }

    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        icon.innerHTML = isPassword ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const firstInput = document.querySelector('.input-box input');
        if (firstInput) {
            setTimeout(() => firstInput.focus(), 400);
        }
    });
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}