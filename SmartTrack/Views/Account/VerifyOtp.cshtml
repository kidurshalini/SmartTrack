@model SmartTrack.ViewModel.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
    Layout = "~/Views/Shared/_Accountlayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="login-container">
    <div class="login-card">

        <!-- Logo -->
        <div class="logo-section">
            <img src="~/image/logo1.png" class="smart-logo" alt="SmartTrack Logo" />
            <p class="brand-tag">Smart Household Inventory Management</p>
        </div>

        <form asp-action="VerifyOtp" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <input asp-for="Email" type="hidden" />

            <div class="form-group">
                <label class="field-label" asp-for="Otp">
                    OTP Code
                </label>
                <div class="input-box">
                    <span class="input-icon"><i class="bi bi-key"></i></span>
                    <input asp-for="Otp" maxlength="6" placeholder="Enter 6-digit OTP" style="text-align: center; letter-spacing: 4px; font-weight: 600;" />
                </div>
                <span asp-validation-for="Otp" class="validation-error"></span>
            </div>


            <button type="submit" class="btn-login">
                <i class="bi bi-check-circle"></i>
                Verify OTP
            </button>

        </form>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const otpInput = document.getElementById('Otp');
        if (otpInput) {
            setTimeout(() => otpInput.focus(), 400);
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}