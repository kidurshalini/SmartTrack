@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="text-center">

  
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
        <i class="bi bi-person-plus"></i>
        Register
    </a>


    @if (User.Identity.IsAuthenticated)
    {
        <h4 class="mt-3">
            Welcome, @User.Identity.Name
        </h4>


        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </button>
        </form>

        <a class="btn btn-success" asp-controller="User" asp-action="Profile">
            <i class="bi bi-person-circle"></i> Profile
        </a>
    }
    else
    {
        <a class="btn btn-success" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right"></i>
            Login
        </a>

    }

    <p class="mt-4">
        Learn about
        <a href="https://learn.microsoft.com/aspnet/core">
            building Web apps with ASP.NET Core
        </a>.
    </p>

</div>