@model SmartTrack.Models.SmartTrackDashboardViewModel

@{
    ViewData["Title"] = "Purchase Recommendations";
}

<div class="container-fluid py-3 py-md-4">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="row align-items-center mb-4">

        <div class="col-12">

            <h2 class="fw-bold mb-2">
                🛒 Purchase Recommendations
            </h2>

            <p class="text-muted mb-0">
                Recommended purchases based on your household
                consumption patterns.
            </p>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <div class="row g-3 mb-4">

        <!-- PURCHASE NOW -->

        <div class="col-12 col-sm-6 col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-3 p-md-4">

                    <small class="text-muted fw-semibold">
                        PURCHASE NOW
                    </small>

                    <h2 class="text-danger fw-bold mb-0">
                        @Model.DueNowCount
                    </h2>

                    <small class="text-muted">
                        Items requiring immediate purchase
                    </small>

                </div>

            </div>

        </div>


        <!-- DUE SOON -->

        <div class="col-12 col-sm-6 col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-3 p-md-4">

                    <small class="text-muted fw-semibold">
                        DUE SOON
                    </small>

                    <h2 class="text-warning fw-bold mb-0">
                        @Model.DueSoonCount
                    </h2>

                    <small class="text-muted">
                        Items needed within 3 days
                    </small>

                </div>

            </div>

        </div>


        <!-- UPCOMING -->

        <div class="col-12 col-sm-6 col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-3 p-md-4">

                    <small class="text-muted fw-semibold">
                        UPCOMING
                    </small>

                    <h2 class="text-info fw-bold mb-0">
                        @Model.UpcomingCount
                    </h2>

                    <small class="text-muted">
                        Items expected within 7 days
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RECOMMENDATIONS
    ====================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-0 py-3 px-3 px-md-4">

            <div class="d-flex flex-column flex-sm-row
                        justify-content-between
                        align-items-start
                        align-items-sm-center
                        gap-2">

                <div>

                    <h5 class="mb-1 fw-semibold">
                        Recommended Purchases
                    </h5>

                    <small class="text-muted">
                        Based on household consumption history
                    </small>

                </div>

                @if (Model.PurchaseRecommendations != null)
                {
                    <span class="badge bg-light text-dark border">
                        @Model.PurchaseRecommendations.Count
                        recommendations
                    </span>
                }

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.PurchaseRecommendations == null ||
                        Model.PurchaseRecommendations.Count == 0)
            {

                <div class="p-4">

                    <div class="alert alert-success mb-0">

                        <i class="fas fa-check-circle me-2"></i>

                        No purchase recommendations at the moment.

                    </div>

                </div>

            }
            else
            {

                <!-- =================================================
                     DESKTOP TABLE
                ================================================== -->

                <div class="d-none d-md-block">

                    <div class="table-responsive">

                        <table class="table table-hover
                                          align-middle
                                          mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th class="px-4">
                                        Product
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Expected Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        Priority
                                    </th>

                                    <th>
                                        Quantity
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item
                                                            in Model.PurchaseRecommendations
                                                            .OrderBy(x => x.DaysUntilPurchase))
                                {

                                    <tr>

                                        <!-- PRODUCT -->

                                        <td class="px-4">

                                            <strong class="text-break">
                                                @item.Product
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                Latest:
                                                @item.LatestQuantity units
                                            </small>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @if (item.DaysUntilPurchase <= 0)
                                            {
                                                <span class="badge bg-danger">
                                                    PURCHASE NOW
                                                </span>
                                            }
                                            else if (item.DaysUntilPurchase <= 3)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    DUE SOON
                                                </span>
                                            }
                                            else if (item.DaysUntilPurchase <= 7)
                                            {
                                                <span class="badge bg-info">
                                                    UPCOMING
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    OK
                                                </span>
                                            }

                                        </td>


                                        <!-- DATE -->

                                        <td class="text-nowrap">

                                            @item.ExpectedPurchaseDate

                                        </td>


                                        <!-- DAYS -->

                                        <td class="text-nowrap">

                                            @if (item.DaysUntilPurchase <= 0)
                                            {
                                                <strong class="text-danger">
                                                    Overdue
                                                </strong>
                                            }
                                            else
                                            {
                                                <strong>
                                                    @item.DaysUntilPurchase
                                                    days left
                                                </strong>
                                            }

                                        </td>


                                        <!-- PRIORITY -->

                                        <td class="text-nowrap">

                                            @if (item.Priority == "HIGH")
                                            {
                                                <span class="text-danger fw-semibold">
                                                    ● High
                                                </span>
                                            }
                                            else if (item.Priority == "MEDIUM")
                                            {
                                                <span class="text-warning fw-semibold">
                                                    ● Medium
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-semibold">
                                                    ● Normal
                                                </span>
                                            }

                                        </td>


                                        <!-- QUANTITY -->

                                        <td>

                                            <strong>
                                                @item.LatestQuantity
                                            </strong>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                ================================================== -->

                <div class="d-md-none">

                    @foreach (var item
                                    in Model.PurchaseRecommendations
                                    .OrderBy(x => x.DaysUntilPurchase))
                    {

                        <div class="p-3 border-bottom">

                            <!-- PRODUCT + STATUS -->

                            <div class="d-flex
                                                justify-content-between
                                                align-items-start
                                                gap-2
                                                mb-3">

                                <div class="flex-grow-1">

                                    <h6 class="fw-bold mb-1 text-break">
                                        @item.Product
                                    </h6>

                                    <small class="text-muted">
                                        Latest:
                                        @item.LatestQuantity units
                                    </small>

                                </div>


                                <div class="flex-shrink-0">

                                    @if (item.DaysUntilPurchase <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            PURCHASE NOW
                                        </span>
                                    }
                                    else if (item.DaysUntilPurchase <= 3)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            DUE SOON
                                        </span>
                                    }
                                    else if (item.DaysUntilPurchase <= 7)
                                    {
                                        <span class="badge bg-info">
                                            UPCOMING
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            OK
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- DETAILS -->

                            <div class="row g-3">

                                <!-- EXPECTED DATE -->

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Expected Date
                                    </small>

                                    <strong>
                                        @item.ExpectedPurchaseDate
                                    </strong>

                                </div>


                                <!-- TIME -->

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Time
                                    </small>

                                    @if (item.DaysUntilPurchase <= 0)
                                    {
                                        <strong class="text-danger">
                                            Overdue
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>
                                            @item.DaysUntilPurchase
                                            days left
                                        </strong>
                                    }

                                </div>


                                <!-- PRIORITY -->

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Priority
                                    </small>

                                    @if (item.Priority == "HIGH")
                                    {
                                        <span class="text-danger fw-semibold">
                                            ● High
                                        </span>
                                    }
                                    else if (item.Priority == "MEDIUM")
                                    {
                                        <span class="text-warning fw-semibold">
                                            ● Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">
                                            ● Normal
                                        </span>
                                    }

                                </div>


                                <!-- QUANTITY -->

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Quantity
                                    </small>

                                    <strong>
                                        @item.LatestQuantity
                                    </strong>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            }

        </div>

    </div>

</div>