@model SmartTrack.Models.SmartTrackDashboardViewModel

@{
    ViewData["Title"] = "Purchase Recommendations";
}

<style>

    /* =========================================================
           SMARTTRACK PURCHASE RECOMMENDATIONS
           ========================================================= */

    .recommendation-page {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
    }


    /* =========================================================
           HERO HEADER
           ========================================================= */

    .recommendation-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        border-radius: 24px;
        padding: 30px 32px;
        margin-bottom: 25px;
        color: white;
        box-shadow: 0 10px 30px rgba(25, 135, 84, .18);
    }

        .recommendation-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -50px;
            top: -80px;
        }

        .recommendation-hero::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            right: 100px;
            bottom: -80px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.18);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 14px;
    }

    .hero-title {
        font-size: 30px;
        font-weight: 800;
        margin: 0 0 8px;
        letter-spacing: -.4px;
    }

    .hero-description {
        margin: 0;
        max-width: 700px;
        color: rgba(255,255,255,.85);
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .summary-card {
        position: relative;
        height: 100%;
        background: white;
        border: 1px solid #edf0f2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(15,23,42,.055);
        transition: all .3s ease;
    }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(15,23,42,.10);
        }

        .summary-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
        }

    .summary-danger::before {
        background: #dc3545;
    }

    .summary-warning::before {
        background: #ffc107;
    }

    .summary-info::before {
        background: #0dcaf0;
    }

    .summary-body {
        padding: 22px;
    }

    .summary-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 15px;
    }

    .summary-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .7px;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .summary-icon-danger {
        background: #fff0f1;
        color: #dc3545;
    }

    .summary-icon-warning {
        background: #fff8e5;
        color: #d39e00;
    }

    .summary-icon-info {
        background: #eafaff;
        color: #0891b2;
    }

    .summary-number {
        font-size: 32px;
        line-height: 1;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .summary-number-danger {
        color: #dc3545;
    }

    .summary-number-warning {
        color: #d39e00;
    }

    .summary-number-info {
        color: #0891b2;
    }

    .summary-description {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           RECOMMENDATION CARD
           ========================================================= */

    .recommendation-card {
        background: white;
        border: 1px solid #edf0f2;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(15,23,42,.06);
    }

    .recommendation-card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #edf0f2;
        background: linear-gradient( 180deg, #ffffff 0%, #fbfdfc 100% );
    }

    .recommendation-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .recommendation-heading {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .recommendation-heading-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f5ee;
        color: #198754;
        font-size: 18px;
    }

    .recommendation-title {
        color: #0f172a;
        font-size: 18px;
        font-weight: 750;
        margin: 0 0 3px;
    }

    .recommendation-subtitle {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    .recommendation-count {
        background: #f1f8f4;
        color: #198754;
        border: 1px solid #dcefe3;
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           DESKTOP TABLE
           ========================================================= */

    .recommendation-table-wrapper {
        overflow-x: auto;
    }

    .recommendation-table {
        width: 100%;
        min-width: 850px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .recommendation-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e9eef2;
            padding: 14px 18px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .6px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .recommendation-table tbody td {
            padding: 17px 18px;
            border-bottom: 1px solid #f0f2f4;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
        }

        .recommendation-table tbody tr {
            transition: background .2s ease;
        }

            .recommendation-table tbody tr:hover {
                background: #f8fcf9;
            }

            .recommendation-table tbody tr:last-child td {
                border-bottom: none;
            }

    .product-name {
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
        max-width: 220px;
    }

    .latest-quantity {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 4px;
    }


    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
        letter-spacing: .2px;
    }

    .status-now {
        background: #fff0f1;
        color: #dc3545;
        border: 1px solid #ffd9dd;
    }

    .status-soon {
        background: #fff8e5;
        color: #a87900;
        border: 1px solid #ffedb0;
    }

    .status-upcoming {
        background: #eafaff;
        color: #087990;
        border: 1px solid #c9f3fc;
    }

    .status-ok {
        background: #eaf8ef;
        color: #198754;
        border: 1px solid #cdebd8;
    }


    /* =========================================================
           PRIORITY
           ========================================================= */

    .priority {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .priority-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .priority-high {
        color: #dc3545;
    }

        .priority-high .priority-dot {
            background: #dc3545;
            box-shadow: 0 0 0 4px #fff0f1;
        }

    .priority-medium {
        color: #b58100;
    }

        .priority-medium .priority-dot {
            background: #ffc107;
            box-shadow: 0 0 0 4px #fff8e5;
        }

    .priority-normal {
        color: #198754;
    }

        .priority-normal .priority-dot {
            background: #198754;
            box-shadow: 0 0 0 4px #eaf8ef;
        }


    /* =========================================================
           DATE / TIME
           ========================================================= */

    .expected-date {
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .days-left {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 700;
    }

    .days-overdue {
        color: #dc3545;
    }

    .days-normal {
        color: #475569;
    }


    /* =========================================================
           QUANTITY PILL
           ========================================================= */

    .quantity-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 7px 10px;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 10px;
        color: #0f172a;
        font-weight: 800;
        font-size: 12px;
    }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        text-align: center;
        padding: 55px 25px;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf8ef;
        color: #198754;
        font-size: 28px;
    }

    .empty-title {
        color: #0f172a;
        font-size: 18px;
        font-weight: 750;
        margin-bottom: 6px;
    }

    .empty-description {
        color: #94a3b8;
        font-size: 13px;
        margin: 0;
    }


    /* =========================================================
           MOBILE CARDS
           ========================================================= */

    .mobile-recommendation {
        padding: 18px;
        border-bottom: 1px solid #edf0f2;
    }

        .mobile-recommendation:last-child {
            border-bottom: none;
        }

    .mobile-product-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 18px;
    }

    .mobile-product {
        min-width: 0;
        flex: 1;
    }

    .mobile-product-name {
        color: #0f172a;
        font-size: 15px;
        font-weight: 750;
        margin-bottom: 4px;
        word-break: break-word;
    }

    .mobile-product-latest {
        color: #94a3b8;
        font-size: 11px;
    }

    .mobile-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .mobile-detail {
        background: #f8fafc;
        border: 1px solid #edf0f2;
        border-radius: 12px;
        padding: 12px;
        min-width: 0;
    }

    .mobile-detail-label {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 5px;
    }

    .mobile-detail-value {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        word-break: break-word;
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {

        .recommendation-page {
            padding: 0 3px;
        }

        .recommendation-hero {
            padding: 23px 20px;
            border-radius: 20px;
        }

        .hero-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            font-size: 20px;
        }

        .hero-title {
            font-size: 23px;
        }

        .hero-description {
            font-size: 12px;
        }

        .summary-card {
            border-radius: 17px;
        }

        .summary-body {
            padding: 18px;
        }

        .summary-number {
            font-size: 28px;
        }

        .recommendation-card {
            border-radius: 18px;
        }

        .recommendation-card-header {
            padding: 18px;
        }

        .recommendation-header-content {
            align-items: flex-start;
        }

        .recommendation-heading-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            font-size: 16px;
        }

        .recommendation-title {
            font-size: 16px;
        }

        .recommendation-subtitle {
            font-size: 11px;
        }

        .recommendation-count {
            font-size: 10px;
            padding: 7px 10px;
        }
    }


    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 480px) {

        .recommendation-hero {
            padding: 20px 16px;
        }

        .hero-title {
            font-size: 21px;
        }

        .hero-description {
            font-size: 11px;
        }

        .summary-body {
            padding: 16px;
        }

        .summary-icon {
            width: 38px;
            height: 38px;
            font-size: 16px;
        }

        .summary-number {
            font-size: 26px;
        }

        .mobile-recommendation {
            padding: 15px;
        }

        .mobile-product-row {
            gap: 8px;
        }

        .mobile-product-name {
            font-size: 14px;
        }

        .mobile-details {
            gap: 8px;
        }

        .mobile-detail {
            padding: 10px;
        }

        .status-badge {
            font-size: 9px;
            padding: 6px 8px;
        }
    }

</style>


<div class="container-fluid py-3 py-md-4">

    <div class="recommendation-page">


        <!-- =====================================================
             HERO HEADER
        ====================================================== -->

        <div class="recommendation-hero">

            <div class="hero-content">

                <div class="hero-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>

                <h1 class="hero-title">
                    Purchase Recommendations
                </h1>

                <p class="hero-description">
                    Smart purchase recommendations based on your
                    household consumption patterns and recent usage history.
                </p>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <div class="row g-3 mb-4">


            <!-- PURCHASE NOW -->

            <div class="col-12 col-sm-6 col-lg-4">

                <div class="summary-card summary-danger">

                    <div class="summary-body">

                        <div class="summary-top">

                            <span class="summary-label">
                                PURCHASE NOW
                            </span>

                            <div class="summary-icon summary-icon-danger">
                                <i class="fas fa-bolt"></i>
                            </div>

                        </div>

                        <div class="summary-number summary-number-danger">
                            @Model.DueNowCount
                        </div>

                        <div class="summary-description">
                            Items requiring immediate purchase
                        </div>

                    </div>

                </div>

            </div>


            <!-- DUE SOON -->

            <div class="col-12 col-sm-6 col-lg-4">

                <div class="summary-card summary-warning">

                    <div class="summary-body">

                        <div class="summary-top">

                            <span class="summary-label">
                                DUE SOON
                            </span>

                            <div class="summary-icon summary-icon-warning">
                                <i class="fas fa-clock"></i>
                            </div>

                        </div>

                        <div class="summary-number summary-number-warning">
                            @Model.DueSoonCount
                        </div>

                        <div class="summary-description">
                            Items needed within the next 3 days
                        </div>

                    </div>

                </div>

            </div>


            <!-- UPCOMING -->

            <div class="col-12 col-sm-6 col-lg-4">

                <div class="summary-card summary-info">

                    <div class="summary-body">

                        <div class="summary-top">

                            <span class="summary-label">
                                UPCOMING
                            </span>

                            <div class="summary-icon summary-icon-info">
                                <i class="fas fa-calendar-alt"></i>
                            </div>

                        </div>

                        <div class="summary-number summary-number-info">
                            @Model.UpcomingCount
                        </div>

                        <div class="summary-description">
                            Items expected within the next 7 days
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             RECOMMENDATIONS CARD
        ====================================================== -->

        <div class="recommendation-card">


            <!-- HEADER -->

            <div class="recommendation-card-header">

                <div class="recommendation-header-content">

                    <div class="recommendation-heading">

                        <div class="recommendation-heading-icon">

                            <i class="fas fa-lightbulb"></i>

                        </div>

                        <div>

                            <h5 class="recommendation-title">
                                Recommended Purchases
                            </h5>

                            <p class="recommendation-subtitle">
                                Based on household consumption history
                            </p>

                        </div>

                    </div>


                    @if (Model.PurchaseRecommendations != null)
                    {

                        <span class="recommendation-count">

                            <i class="fas fa-list-ul me-1"></i>

                            @Model.PurchaseRecommendations.Count
                            recommendations

                        </span>

                    }

                </div>

            </div>


            <!-- BODY -->

            <div>


                @if (Model.PurchaseRecommendations == null ||
                                Model.PurchaseRecommendations.Count == 0)
                {

                    <!-- =================================================
                         EMPTY STATE
                    ================================================== -->

                    <div class="empty-state">

                        <div class="empty-icon">

                            <i class="fas fa-check"></i>

                        </div>

                        <div class="empty-title">

                            You're all caught up!

                        </div>

                        <p class="empty-description">

                            No purchase recommendations are needed
                            at the moment.

                        </p>

                    </div>

                }
                else
                {


                    <!-- =================================================
                         DESKTOP TABLE
                    ================================================== -->

                    <div class="d-none d-md-block">

                        <div class="recommendation-table-wrapper">

                            <table class="recommendation-table">

                                <thead>

                                    <tr>

                                        <th class="ps-4">
                                            Product
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Expected Date
                                        </th>

                                        <th>
                                            Time
                                        </th>

                                        <th>
                                            Priority
                                        </th>

                                        <th>
                                            Quantity
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var item in Model.PurchaseRecommendations
                                                                    .OrderBy(x => x.DaysUntilPurchase))
                                    {

                                        <tr>


                                            <!-- PRODUCT -->

                                            <td class="ps-4">

                                                <div class="product-name text-break">
                                                    @item.Product
                                                </div>

                                                <div class="latest-quantity">

                                                    <i class="fas fa-box me-1"></i>

                                                    Latest:
                                                    @item.LatestQuantity units

                                                </div>

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                @if (item.DaysUntilPurchase <= 0)
                                                {

                                                    <span class="status-badge status-now">

                                                        <i class="fas fa-exclamation-circle"></i>

                                                        PURCHASE NOW

                                                    </span>

                                                }
                                                else if (item.DaysUntilPurchase <= 3)
                                                {

                                                    <span class="status-badge status-soon">

                                                        <i class="fas fa-clock"></i>

                                                        DUE SOON

                                                    </span>

                                                }
                                                else if (item.DaysUntilPurchase <= 7)
                                                {

                                                    <span class="status-badge status-upcoming">

                                                        <i class="fas fa-calendar"></i>

                                                        UPCOMING

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="status-badge status-ok">

                                                        <i class="fas fa-check"></i>

                                                        OK

                                                    </span>

                                                }

                                            </td>


                                            <!-- EXPECTED DATE -->

                                            <td>

                                                <span class="expected-date">

                                                    <i class="far fa-calendar-alt me-1"></i>

                                                    @item.ExpectedPurchaseDate

                                                </span>

                                            </td>


                                            <!-- TIME -->

                                            <td>

                                                @if (item.DaysUntilPurchase <= 0)
                                                {

                                                    <span class="days-left days-overdue">

                                                        <i class="fas fa-exclamation-triangle"></i>

                                                        Overdue

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="days-left days-normal">

                                                        <i class="far fa-clock"></i>

                                                        @item.DaysUntilPurchase days left

                                                    </span>

                                                }

                                            </td>


                                            <!-- PRIORITY -->

                                            <td>

                                                @if (item.Priority == "HIGH")
                                                {

                                                    <span class="priority priority-high">

                                                        <span class="priority-dot"></span>

                                                        High

                                                    </span>

                                                }
                                                else if (item.Priority == "MEDIUM")
                                                {

                                                    <span class="priority priority-medium">

                                                        <span class="priority-dot"></span>

                                                        Medium

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="priority priority-normal">

                                                        <span class="priority-dot"></span>

                                                        Normal

                                                    </span>

                                                }

                                            </td>


                                            <!-- QUANTITY -->

                                            <td>

                                                <span class="quantity-pill">

                                                    @item.LatestQuantity

                                                </span>

                                            </td>


                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- =================================================
                         MOBILE CARDS
                    ================================================== -->

                    <div class="d-md-none">

                        @foreach (var item in Model.PurchaseRecommendations
                                            .OrderBy(x => x.DaysUntilPurchase))
                        {

                            <div class="mobile-recommendation">


                                <!-- PRODUCT + STATUS -->

                                <div class="mobile-product-row">

                                    <div class="mobile-product">

                                        <div class="mobile-product-name">

                                            @item.Product

                                        </div>

                                        <div class="mobile-product-latest">

                                            <i class="fas fa-box me-1"></i>

                                            Latest:
                                            @item.LatestQuantity units

                                        </div>

                                    </div>


                                    <!-- STATUS -->

                                    <div class="flex-shrink-0">

                                        @if (item.DaysUntilPurchase <= 0)
                                        {

                                            <span class="status-badge status-now">

                                                <i class="fas fa-exclamation-circle"></i>

                                                PURCHASE NOW

                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 3)
                                        {

                                            <span class="status-badge status-soon">

                                                <i class="fas fa-clock"></i>

                                                DUE SOON

                                            </span>

                                        }
                                        else if (item.DaysUntilPurchase <= 7)
                                        {

                                            <span class="status-badge status-upcoming">

                                                <i class="fas fa-calendar"></i>

                                                UPCOMING

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-badge status-ok">

                                                <i class="fas fa-check"></i>

                                                OK

                                            </span>

                                        }

                                    </div>

                                </div>


                                <!-- DETAILS -->

                                <div class="mobile-details">


                                    <!-- EXPECTED DATE -->

                                    <div class="mobile-detail">

                                        <span class="mobile-detail-label">
                                            Expected Date
                                        </span>

                                        <span class="mobile-detail-value">

                                            <i class="far fa-calendar-alt me-1"></i>

                                            @item.ExpectedPurchaseDate

                                        </span>

                                    </div>


                                    <!-- TIME -->

                                    <div class="mobile-detail">

                                        <span class="mobile-detail-label">
                                            Time
                                        </span>

                                        @if (item.DaysUntilPurchase <= 0)
                                        {

                                            <span class="mobile-detail-value text-danger">

                                                <i class="fas fa-exclamation-triangle me-1"></i>

                                                Overdue

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="mobile-detail-value">

                                                <i class="far fa-clock me-1"></i>

                                                @item.DaysUntilPurchase days left

                                            </span>

                                        }

                                    </div>


                                    <!-- PRIORITY -->

                                    <div class="mobile-detail">

                                        <span class="mobile-detail-label">
                                            Priority
                                        </span>


                                        @if (item.Priority == "HIGH")
                                        {

                                            <span class="priority priority-high">

                                                <span class="priority-dot"></span>

                                                High

                                            </span>

                                        }
                                        else if (item.Priority == "MEDIUM")
                                        {

                                            <span class="priority priority-medium">

                                                <span class="priority-dot"></span>

                                                Medium

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="priority priority-normal">

                                                <span class="priority-dot"></span>

                                                Normal

                                            </span>

                                        }

                                    </div>


                                    <!-- QUANTITY -->

                                    <div class="mobile-detail">

                                        <span class="mobile-detail-label">
                                            Quantity
                                        </span>

                                        <span class="mobile-detail-value">

                                            <i class="fas fa-box me-1"></i>

                                            @item.LatestQuantity

                                        </span>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                }

            </div>

        </div>

    </div>

</div>