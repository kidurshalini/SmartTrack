@{
    // ============================================================
    // USER INFORMATION
    // ============================================================

    string userName = Context.Session.GetString("UserName") ?? "Guest";
    string userRole = Context.Session.GetString("UserRole") ?? "User";

    string userInitial = !string.IsNullOrEmpty(userName)
        ? userName.Substring(0, 1).ToUpper()
        : "?";

    // ============================================================
    // CURRENT CONTROLLER / ACTION
    // ============================================================

    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SmartTrack
    </title>


    <!-- ========================================================
         BOOTSTRAP
         ======================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ========================================================
         FONT AWESOME
         ======================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />


    <!-- ========================================================
         GOOGLE FONT
         ======================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />


    <!-- ========================================================
         SITE CSS
         ======================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartTrack.styles.css"
          asp-append-version="true" />


    <style>

        /* ============================================================
                   ROOT VARIABLES
                   ============================================================ */

        :root {
            --primary-green: #198754;
            --primary-green-dark: #157347;
            --primary-green-light: #dff6e9;
            --primary-blue: #0d6efd;
            --dark-blue: #084298;
            --sidebar-bg: #242424;
            --sidebar-bg-light: #2c2c2c;
            --sidebar-hover: #343434;
            --sidebar-text: #f5f5f5;
            --sidebar-muted: #999;
            --sidebar-width: 270px;
            --sidebar-collapsed-width: 72px;
            --body-bg: #f4f6f8;
            --card-bg: #ffffff;
            --border-color: #e5e7eb;
            --shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --shadow-md: 0 8px 25px rgba(0,0,0,.08);
            --shadow-lg: 0 15px 45px rgba(0,0,0,.15);
            --radius-sm: 10px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --transition: all .28s cubic-bezier(.4,0,.2,1);
            --header-height: 68px;
        }


        /* ============================================================
                   GLOBAL
                   ============================================================ */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html,
        body {
            min-height: 100%;
            margin: 0;
            padding: 0;
        }


        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--body-bg);
            color: #111827;
            overflow-x: hidden;
            min-height: 100vh;
        }


        a {
            text-decoration: none;
            color: inherit;
        }


        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }


        /* ============================================================
                   APP WRAPPER
                   ============================================================ */

        .app-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }


        /* ============================================================
                   SIDEBAR
                   ============================================================ */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient( 180deg, #272727 0%, #222222 100% );
            color: var(--sidebar-text);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,.05);
            box-shadow: 5px 0 25px rgba(0,0,0,.08);
            overflow: hidden;
            transition: width .3s ease, transform .3s ease;
        }


        /* ============================================================
                   LOGO AREA
                   ============================================================ */

        .logo-section {
            min-height: var(--header-height);
            padding: 12px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #eeeeee;
            border-bottom: 1px solid rgba(0,0,0,.08);
            flex-shrink: 0;
        }


        .logo-wrapper {
            flex: 1;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        .smart-logo {
            height: 38px;
            width: auto;
            max-width: 180px;
            object-fit: contain;
            display: block;
        }


        .toggle-sidebar-btn {
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            cursor: pointer;
            transition: var(--transition);
            flex-shrink: 0;
        }


            .toggle-sidebar-btn:hover {
                background: rgba(0,0,0,.08);
                transform: scale(1.05);
            }


        /* ============================================================
                   SIDEBAR NAVIGATION
                   ============================================================ */

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 18px 12px 20px;
            scrollbar-width: thin;
            scrollbar-color: #4b4b4b transparent;
        }


            .sidebar-nav::-webkit-scrollbar {
                width: 5px;
            }


            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }


            .sidebar-nav::-webkit-scrollbar-thumb {
                background: #4b4b4b;
                border-radius: 20px;
            }


        /* ============================================================
                   SECTION TITLE
                   ============================================================ */

        .nav-label {
            padding: 8px 11px 10px;
            color: #888;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            white-space: nowrap;
        }


        .sidebar-nav ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }


        .sidebar-nav .nav-item {
            margin-bottom: 4px;
        }


        /* ============================================================
                   NAV LINK
                   ============================================================ */

        .sidebar-nav .nav-link {
            position: relative;
            min-height: 44px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 13px;
            border-radius: 11px;
            color: #d7d7d7;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            transition: var(--transition);
        }


            .sidebar-nav .nav-link i {
                width: 21px;
                min-width: 21px;
                text-align: center;
                font-size: 16px;
                color: #929292;
                transition: var(--transition);
            }


            .sidebar-nav .nav-link .link-text {
                overflow: hidden;
                text-overflow: ellipsis;
                opacity: 1;
                transition: opacity .2s ease, transform .2s ease;
            }


            /* ============================================================
                   HOVER
                   ============================================================ */

            .sidebar-nav .nav-link:hover {
                background: var(--sidebar-hover);
                color: #fff;
                transform: translateX(2px);
            }


                .sidebar-nav .nav-link:hover i {
                    color: #fff;
                    transform: scale(1.08);
                }


            /* ============================================================
                   ACTIVE LINK
                   ============================================================ */

            .sidebar-nav .nav-link.active {
                background: linear-gradient( 135deg, #198754, #157347 );
                color: #fff;
                box-shadow: 0 6px 18px rgba(25,135,84,.25);
            }


                .sidebar-nav .nav-link.active i {
                    color: #fff;
                }


                .sidebar-nav .nav-link.active::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 8px;
                    bottom: 8px;
                    width: 3px;
                    border-radius: 0 4px 4px 0;
                    background: #fff;
                }


        /* ============================================================
                   SIDEBAR FOOTER
                   ============================================================ */

        .sidebar-footer {
            min-height: 76px;
            padding: 13px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(0,0,0,.16);
            border-top: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }


        /* ============================================================
                   AVATAR
                   ============================================================ */

        .avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 12px;
            background: linear-gradient( 135deg, #0d6efd, #084298 );
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 5px 15px rgba(13,110,253,.25);
        }


        /* ============================================================
                   USER INFORMATION
                   ============================================================ */

        .user-info {
            flex: 1;
            min-width: 0;
        }


            .user-info .name {
                display: block;
                color: #fff;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                margin-bottom: 3px;
            }


                .user-info .name:hover {
                    color: #7ee2a8;
                }


            .user-info .role {
                color: #8f8f8f;
                font-size: 10px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }


        /* ============================================================
                   LOGOUT
                   ============================================================ */

        .logout-btn {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: #999;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }


            .logout-btn:hover {
                background: rgba(220,53,69,.15);
                color: #ff6b7a;
                transform: scale(1.05);
            }


        /* ============================================================
                   MAIN AREA
                   ============================================================ */

        .main-area {
            flex: 1;
            min-width: 0;
            min-height: 100vh;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            background: var(--body-bg);
            transition: margin-left .3s ease;
        }


        /* ============================================================
                   PAGE CONTENT
                   ============================================================ */

        .page-content {
            flex: 1;
            width: 100%;
            min-height: calc(100vh - 70px);
            padding: 30px 34px 42px;
            background: var(--body-bg);
        }


        /* ============================================================
                   FOOTER
                   ============================================================ */

        .main-footer {
            width: 100%;
            padding: 15px 25px;
            background: rgba(255,255,255,.75);
            border-top: 1px solid var(--border-color);
            color: #64748b;
            font-size: 12px;
            text-align: center;
            flex-shrink: 0;
        }


            .main-footer strong {
                color: #334155;
            }


            .main-footer a {
                color: var(--primary-green);
                font-weight: 600;
                transition: var(--transition);
            }


                .main-footer a:hover {
                    color: var(--primary-green-dark);
                    text-decoration: underline;
                }


            .main-footer .fa-heart {
                color: #dc3545;
                margin: 0 3px;
            }


        /* ============================================================
                   COLLAPSED DESKTOP SIDEBAR
                   ============================================================ */

        .sidebar.collapsed {
            width: var(--sidebar-collapsed-width);
        }


            .sidebar.collapsed .logo-section {
                padding: 10px 0;
                justify-content: center;
            }


            .sidebar.collapsed .logo-wrapper {
                display: none;
            }


            .sidebar.collapsed .toggle-sidebar-btn {
                margin: auto;
            }


            .sidebar.collapsed .nav-label {
                opacity: 0;
                height: 0;
                padding: 0;
                overflow: hidden;
            }


            .sidebar.collapsed .link-text {
                opacity: 0;
                width: 0;
                transform: translateX(-10px);
                pointer-events: none;
            }


            .sidebar.collapsed .nav-link {
                justify-content: center;
                gap: 0;
                padding: 10px 0;
            }


                .sidebar.collapsed .nav-link i {
                    width: 38px;
                    min-width: 38px;
                    height: 38px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 10px;
                }


                .sidebar.collapsed .nav-link:hover i {
                    background: var(--sidebar-hover);
                }


                .sidebar.collapsed .nav-link.active {
                    background: transparent;
                    box-shadow: none;
                }


                    .sidebar.collapsed .nav-link.active::before {
                        display: none;
                    }


                    .sidebar.collapsed .nav-link.active i {
                        background: linear-gradient( 135deg, #198754, #157347 );
                        box-shadow: 0 5px 15px rgba(25,135,84,.25);
                    }


            .sidebar.collapsed .sidebar-footer {
                padding: 12px 0;
                justify-content: center;
            }


            .sidebar.collapsed .avatar,
            .sidebar.collapsed .user-info {
                display: none;
            }


            .sidebar.collapsed .logout-btn {
                width: 38px;
                height: 38px;
            }


        .main-area.expanded {
            margin-left: var(--sidebar-collapsed-width);
        }


        /* ============================================================
                   MOBILE FLOATING BUTTON
                   ============================================================ */

        .floating-toggle {
            display: none;
            position: fixed;
            top: 14px;
            left: 14px;
            width: 44px;
            height: 44px;
            border: none;
            border-radius: 12px;
            background: linear-gradient( 135deg, #242424, #353535 );
            color: #fff;
            font-size: 18px;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1060;
            box-shadow: 0 8px 22px rgba(0,0,0,.25);
            transition: var(--transition);
        }


            .floating-toggle:hover {
                transform: translateY(-2px);
                background: linear-gradient( 135deg, #198754, #157347 );
            }


        /* ============================================================
                   MOBILE BACKDROP
                   ============================================================ */

        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.48);
            backdrop-filter: blur(3px);
            z-index: 1045;
        }


            .sidebar-backdrop.show {
                display: block;
            }


        /* ============================================================
                   TABLET
                   ============================================================ */

        @@media (max-width: 992px) {

            .sidebar {
                width: 280px;
                transform: translateX(-100%);
                box-shadow: 10px 0 35px rgba(0,0,0,.18);
            }


                .sidebar.mobile-open {
                    transform: translateX(0);
                }


            .main-area,
            .main-area.expanded {
                margin-left: 0 !important;
            }


            .page-content {
                padding: 24px 22px 34px;
            }


            .floating-toggle {
                display: flex;
            }


            .logo-section {
                justify-content: center;
            }


                .logo-section .toggle-sidebar-btn {
                    display: none;
                }


            .sidebar.collapsed {
                width: 280px;
                transform: translateX(-100%);
            }


                .sidebar.collapsed.mobile-open {
                    transform: translateX(0);
                }
        }


        /* ============================================================
                   MOBILE
                   ============================================================ */

        @@media (max-width: 576px) {

            .page-content {
                padding: 18px 14px 28px;
            }


            .sidebar {
                width: 270px;
            }


            .logo-section {
                min-height: 60px;
                padding: 10px 14px;
            }


            .smart-logo {
                height: 31px;
                max-width: 170px;
            }


            .sidebar-nav {
                padding: 14px 10px 18px;
            }


                .sidebar-nav .nav-link {
                    min-height: 46px;
                    padding: 10px 11px;
                    font-size: 13px;
                }


            .sidebar-footer {
                min-height: 70px;
                padding: 11px 13px;
            }


            .avatar {
                width: 36px;
                height: 36px;
                min-width: 36px;
                border-radius: 10px;
            }


            .main-footer {
                padding: 12px 14px;
                font-size: 11px;
            }


            .floating-toggle {
                width: 40px;
                height: 40px;
                top: 10px;
                left: 10px;
                border-radius: 11px;
                font-size: 16px;
            }
        }


        /* ============================================================
                   EXTRA SMALL DEVICES
                   ============================================================ */

        @@media (max-width: 380px) {

            .sidebar {
                width: 255px;
            }


            .page-content {
                padding: 16px 11px 24px;
            }
        }

    </style>

</head>


<body>

    <div class="app-wrapper">


        <!-- ============================================================
             SIDEBAR
             ============================================================ -->

        <aside class="sidebar"
               id="sidebar">


            <!-- ========================================================
                 LOGO
                 ======================================================== -->

            <div class="logo-section">

                <div class="logo-wrapper">

                    <img src="~/image/logo1.png"
                         class="smart-logo"
                         alt="SmartTrack Logo" />

                </div>


                <button type="button"
                        class="toggle-sidebar-btn"
                        id="sidebarToggleBtn"
                        aria-label="Toggle sidebar"
                        title="Collapse sidebar">

                    <i class="fas fa-bars"></i>

                </button>

            </div>


            <!-- ========================================================
                 NAVIGATION
                 ======================================================== -->

            <nav class="sidebar-nav">

                <div class="nav-label">
                    Main Menu
                </div>


                <ul>


                    <!-- ==================================================
                         DASHBOARD
                         ================================================== -->

                    <li class="nav-item">

                        <a class="nav-link @(currentController == "SmartTrackDashboard" && currentAction == "Index" ? "active" : "")"
                           asp-area=""
                           asp-controller="SmartTrackDashboard"
                           asp-action="Index"
                           title="Dashboard">

                            <i class="fas fa-chart-pie"></i>

                            <span class="link-text">
                                Dashboard
                            </span>

                        </a>

                    </li>


                    <!-- ==================================================
                         OWNER / FAMILY MEMBER OPTIONS
                         ================================================== -->
                    @if (User.IsInRole("FamilyMembers") ||
                                        User.IsInRole("HouseholdOwner"))
                    {

                        <!-- ADD RECEIPT -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Receipt" && currentAction == "Scan" ? "active" : "")"
                               asp-area=""
                               asp-controller="Receipt"
                               asp-action="Scan"
                               title="Add Receipt">

                                <i class="fas fa-receipt"></i>

                                <span class="link-text">
                                    Add Receipt
                                </span>

                            </a>

                        </li>


                        <!-- SHOPPING LIST -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "ShoppingList" && currentAction == "Index" ? "active" : "")"
                               asp-area=""
                               asp-controller="ShoppingList"
                               asp-action="Index"
                               title="Shopping List">

                                <i class="fas fa-cart-shopping"></i>

                                <span class="link-text">
                                    Shopping List
                                </span>

                            </a>

                        </li>


                        <!-- DAILY USAGE -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "SmartTrackStock" && currentAction == "Index" ? "active" : "")"
                               asp-area=""
                               asp-controller="SmartTrackStock"
                               asp-action="Index"
                               title="Daily Usage">

                                <i class="fas fa-chart-line"></i>

                                <span class="link-text">
                                    Daily Usage
                                </span>

                            </a>

                        </li>

                    }


                    <!-- ==================================================
                         VIEW RECEIPTS
                         ================================================== -->

                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Receipt" && currentAction == "ViewSavedReceipts" ? "active" : "")"
                           asp-area=""
                           asp-controller="Receipt"
                           asp-action="ViewSavedReceipts"
                           title="View Receipts">

                            <i class="fas fa-folder-open"></i>

                            <span class="link-text">
                                View Receipts
                            </span>

                        </a>

                    </li>


                    <!-- ==================================================
                         PURCHASE RECOMMENDATIONS
                         ================================================== -->

                    <li class="nav-item">

                        <a class="nav-link @(currentController == "SmartTrackDashboard" && currentAction == "Recommendations" ? "active" : "")"
                           asp-area=""
                           asp-controller="SmartTrackDashboard"
                           asp-action="Recommendations"
                           title="Purchase Recommendations">

                            <i class="fas fa-lightbulb"></i>

                            <span class="link-text">
                                Purchase Recommendations
                            </span>

                        </a>

                    </li>

                </ul>

            </nav>


            <!-- ========================================================
                 USER FOOTER
                 ======================================================== -->

            <div class="sidebar-footer">


                <!-- AVATAR -->

                <div class="avatar">

                    @userInitial

                </div>


                <!-- USER DETAILS -->

                <div class="user-info">

                    <a class="name"
                       asp-controller="User"
                       asp-action="Profile">

                        @userName

                    </a>

                    <div class="role">

                        @userRole

                    </div>

                </div>


                <!-- LOGOUT -->

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      id="logoutForm">

                    @Html.AntiForgeryToken()

                    <button type="button"
                            class="logout-btn"
                            id="logoutButton"
                            title="Logout">

                        <i class="fas fa-right-from-bracket"></i>

                    </button>

                </form>

            </div>

        </aside>


        <!-- ============================================================
             MOBILE MENU BUTTON
             ============================================================ -->

        <button type="button"
                class="floating-toggle"
                id="floatingToggleBtn"
                aria-label="Open navigation menu">

            <i class="fas fa-bars"></i>

        </button>


        <!-- ============================================================
             BACKDROP
             ============================================================ -->

        <div class="sidebar-backdrop"
             id="sidebarBackdrop">
        </div>


        <!-- ============================================================
             MAIN CONTENT AREA
             ============================================================ -->

        <div class="main-area"
             id="mainArea">


            <main class="page-content">

                @RenderBody()

            </main>


            <!-- ========================================================
                 FOOTER
                 ======================================================== -->

            <footer class="main-footer">

                &copy; 2026

                <strong>SmartTrack</strong>

                &mdash;

                Smart household consumption management

                <i class="fas fa-heart"></i>

                &middot;

                <a asp-controller="Home"
                   asp-action="Privacy">

                    Privacy

                </a>

            </footer>

        </div>

    </div>


    <!-- ================================================================
         JAVASCRIPT
         ================================================================ -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        (function () {

            'use strict';


            /* ============================================================
               ELEMENTS
               ============================================================ */

            const sidebar =
                document.getElementById('sidebar');

            const mainArea =
                document.getElementById('mainArea');

            const sidebarToggle =
                document.getElementById('sidebarToggleBtn');

            const floatingToggle =
                document.getElementById('floatingToggleBtn');

            const backdrop =
                document.getElementById('sidebarBackdrop');

            const logoutButton =
                document.getElementById('logoutButton');

            const logoutForm =
                document.getElementById('logoutForm');


            /* ============================================================
               MOBILE CHECK
               ============================================================ */

            function isMobile() {

                return window.innerWidth <= 992;

            }


            /* ============================================================
               OPEN MOBILE SIDEBAR
               ============================================================ */

            function openMobileSidebar() {

                sidebar.classList.add('mobile-open');

                backdrop.classList.add('show');

                document.body.style.overflow = 'hidden';


                floatingToggle.innerHTML =
                    '<i class="fas fa-xmark"></i>';

            }


            /* ============================================================
               CLOSE MOBILE SIDEBAR
               ============================================================ */

            function closeMobileSidebar() {

                sidebar.classList.remove('mobile-open');

                backdrop.classList.remove('show');

                document.body.style.overflow = '';


                floatingToggle.innerHTML =
                    '<i class="fas fa-bars"></i>';

            }


            /* ============================================================
               TOGGLE SIDEBAR
               ============================================================ */

            function toggleSidebar() {

                if (isMobile()) {

                    if (
                        sidebar.classList.contains(
                            'mobile-open'
                        )
                    ) {

                        closeMobileSidebar();

                    }
                    else {

                        openMobileSidebar();

                    }

                }
                else {

                    sidebar.classList.toggle(
                        'collapsed'
                    );

                    mainArea.classList.toggle(
                        'expanded'
                    );


                    const collapsed =
                        sidebar.classList.contains(
                            'collapsed'
                        );


                    localStorage.setItem(
                        'smarttrack-sidebar-collapsed',
                        collapsed
                            ? 'true'
                            : 'false'
                    );


                    updateDesktopToggleIcon();

                }

            }


            /* ============================================================
               DESKTOP ICON
               ============================================================ */

            function updateDesktopToggleIcon() {

                if (isMobile()) {

                    return;

                }


                if (
                    sidebar.classList.contains(
                        'collapsed'
                    )
                ) {

                    sidebarToggle.innerHTML =
                        '<i class="fas fa-chevron-right"></i>';

                    sidebarToggle.title =
                        'Expand sidebar';

                }
                else {

                    sidebarToggle.innerHTML =
                        '<i class="fas fa-bars"></i>';

                    sidebarToggle.title =
                        'Collapse sidebar';

                }

            }


            /* ============================================================
               EVENTS
               ============================================================ */

            sidebarToggle?.addEventListener(
                'click',
                toggleSidebar
            );


            floatingToggle?.addEventListener(
                'click',
                toggleSidebar
            );


            backdrop?.addEventListener(
                'click',
                closeMobileSidebar
            );


            /* ============================================================
               ESCAPE KEY
               ============================================================ */

            document.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key === 'Escape' &&
                        isMobile() &&
                        sidebar.classList.contains(
                            'mobile-open'
                        )
                    ) {

                        closeMobileSidebar();

                    }

                }
            );


            /* ============================================================
               AUTO CLOSE MOBILE AFTER CLICKING NAVIGATION
               ============================================================ */

            document
                .querySelectorAll('.sidebar-nav .nav-link')
                .forEach(function (link) {

                    link.addEventListener(
                        'click',
                        function () {

                            if (isMobile()) {

                                closeMobileSidebar();

                            }

                        }
                    );

                });


            /* ============================================================
               LOGOUT
               ============================================================ */

            logoutButton?.addEventListener(
                'click',
                function () {

                    if (
                        confirm(
                            'Are you sure you want to logout from SmartTrack?'
                        )
                    ) {

                        this.disabled = true;

                        this.innerHTML =
                            '<i class="fas fa-spinner fa-spin"></i>';

                        logoutForm.submit();

                    }

                }
            );


            /* ============================================================
               RESTORE SIDEBAR STATE
               ============================================================ */

            function restoreSidebarState() {

                if (!isMobile()) {

                    const stored =
                        localStorage.getItem(
                            'smarttrack-sidebar-collapsed'
                        );


                    if (stored === 'true') {

                        sidebar.classList.add(
                            'collapsed'
                        );

                        mainArea.classList.add(
                            'expanded'
                        );

                    }
                    else {

                        sidebar.classList.remove(
                            'collapsed'
                        );

                        mainArea.classList.remove(
                            'expanded'
                        );

                    }


                    updateDesktopToggleIcon();

                }
                else {

                    sidebar.classList.remove(
                        'collapsed'
                    );

                    mainArea.classList.remove(
                        'expanded'
                    );

                    closeMobileSidebar();

                }

            }


            /* ============================================================
               INITIALIZE
               ============================================================ */

            restoreSidebarState();


            /* ============================================================
               RESPONSIVE RESIZE
               ============================================================ */

            let resizeTimer;


            window.addEventListener(
                'resize',
                function () {

                    clearTimeout(
                        resizeTimer
                    );


                    resizeTimer = setTimeout(
                        function () {

                            restoreSidebarState();

                        },
                        150
                    );

                }
            );


        })();

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>